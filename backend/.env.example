# MailAgent Backend Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ===== ENVIRONMENT =====
NODE_ENV=development
LOG_LEVEL=debug

# ===== LOGGING =====
# Directory for log files (default: ./logs)
# LOG_DIR=./logs
# Enable verbose request logging (default: false)
# LOG_REQUESTS=false

# ===== SERVER =====
API_PORT=3000
API_HOST=localhost
# Public URL for OAuth callbacks and webhooks (use ngrok for local dev)
API_PUBLIC_URL=http://localhost:3000
# Trust proxy settings for reverse proxy (nginx/traefik)
# Options: "loopback,linklocal,uniquelocal", true, false, or specific IPs
TRUST_PROXY=loopback,linklocal,uniquelocal
# Rate limiting (requests per time window)
RATE_LIMIT_MAX=300
RATE_LIMIT_TTL_MS=60000

# ===== DATABASE =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=mailuser
DB_PASSWORD=your-strong-password-here
DB_NAME=mailagent
# Full connection URL (for Prisma - use localhost for local dev)
DATABASE_URL=postgresql://mailuser:your-strong-password-here@localhost:5432/mailagent

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379
# IMPORTANT: Set password for production! Docker dev default: mailagent_dev_redis
REDIS_PASSWORD=mailagent_dev_redis
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY_MS=1000
# Separate DB for query embedding cache (optional)
REDIS_QUERY_CACHE_DB=1

# ===== JWT & AUTH =====
# IMPORTANT: Generate strong secrets for production!
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=24h
OTP_EXPIRATION=900000
# IMPORTANT: Must be different from JWT_SECRET and at least 32 characters
PASSWORD_RESET_SECRET=change-me-in-production-different-from-jwt-secret
PASSWORD_RESET_EXPIRATION=900000
# IMPORTANT: Must be different from JWT_SECRET and PASSWORD_RESET_SECRET
REFRESH_TOKEN_SECRET=change-me-in-production-different-from-others

# ===== ENCRYPTION =====
# IMPORTANT: Generate strong key for production!
# Generate with: openssl rand -base64 32
AES_SECRET_KEY=default-key-change-in-production

# ===== OAUTH2 CREDENTIALS (Gmail/Google) =====
# Get these from Google Cloud Console
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
# Redirect URI is derived from API_PUBLIC_URL: ${API_PUBLIC_URL}/auth/gmail/callback
# Only set explicitly if you need a different URL:
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

# Google Cloud Pub/Sub topic (format: projects/{project-id}/topics/{topic-name})
# Create this topic in your Google Cloud Console
GOOGLE_PUBSUB_TOPIC=projects/your-project-id/topics/your-topic-name

# ===== OAUTH2 CREDENTIALS (Microsoft) =====
# Get these from Azure Portal (App Registrations)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
# Redirect URI is derived from API_PUBLIC_URL: ${API_PUBLIC_URL}/auth/microsoft/callback
# Only set explicitly if you need a different URL:
# MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# ===== WEBHOOK CONFIGURATION =====
# Webhook URLs are derived from API_PUBLIC_URL automatically:
# - Email: ${API_PUBLIC_URL}/webhooks/microsoft/notifications
# - Calendar: ${API_PUBLIC_URL}/webhooks/calendar/microsoft/notifications
# - Contacts: ${API_PUBLIC_URL}/webhooks/contacts/microsoft/notifications
# Only set explicitly if you need different URLs:
# MICROSOFT_EMAIL_WEBHOOK_URL=http://localhost:3000/webhooks/microsoft/notifications
# MICROSOFT_CALENDAR_WEBHOOK_URL=http://localhost:3000/webhooks/calendar/microsoft/notifications
WEBHOOK_CLIENT_STATE=mailagent-ms-calendar

# ===== AI PROVIDER (Mistral) =====
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-medium-latest
# Optional: custom API base URL
# MISTRAL_API_BASE_URL=https://api.mistral.ai
# MISTRAL_HEALTH_TIMEOUT_MS=3000

# ===== AI Configuration =====
# Model settings (by task complexity)
AI_DEFAULT_MODEL=mistral-small-latest
AI_ROUTER_MODEL=mistral-small-latest
AI_EMBEDDING_MODEL=mistral-embed
# Model tiers for different tasks (cost optimization)
AI_MODEL_SIMPLE=mistral-small-latest   # Classification, labeling, simple tasks
AI_MODEL_MEDIUM=mistral-small-latest   # Extraction, smart replies, summaries
AI_MODEL_COMPLEX=mistral-medium-latest # Composition, complex reasoning
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048

# Queue settings (for rate limiting and scalability)
AI_QUEUE_CONCURRENCY=5                  # Max concurrent AI jobs
AI_QUEUE_RATE_LIMIT=10                  # Max jobs per second

# Memory settings
AI_MAX_HISTORY=50
AI_SESSION_TTL=3600
AI_FIFO_TRIM=10

# HITL (Human-in-the-Loop) settings
AI_AUTO_APPROVE_THRESHOLD=0.9
AI_ACTION_EXPIRATION=24
AI_MAX_PENDING_ACTIONS=50

# Learning settings
AI_MIN_LEARNING_SAMPLES=5
AI_CONFIDENCE_BOOST_MAX=0.15
AI_CONFIDENCE_PENALTY_MAX=0.2
AI_LEARNING_DECAY=0.95

# Rate limiting (requests per user)
AI_RATE_LIMIT_RPM=30
AI_RATE_LIMIT_RPD=1000
AI_CONCURRENT_LIMIT=3

# Feature flags
AI_SMART_REPLIES=true
AI_SUMMARIZATION=true
AI_SCHEDULING=true
AI_CONTACT_DEDUPE=true
AI_PROACTIVE=false

# Email agent
AI_MAX_SMART_REPLIES=3
AI_SUMMARY_MAX_LENGTH=500
AI_DEFAULT_TONE=formal

# Calendar agent
AI_MAX_CALENDAR_SLOTS=5
AI_BUSINESS_START=9
AI_BUSINESS_END=17
AI_DEFAULT_MEETING_DURATION=60

# Contacts agent
AI_DEDUPE_THRESHOLD=0.7
AI_MAX_MERGE_SUGGESTIONS=10

# Embeddings
AI_MAX_CHARS_PER_CHUNK=12000
AI_MAX_EMBEDDING_DIM=4096
AI_QUERY_CACHE_TTL=3600

# Semantic Cache (50-60% cost reduction)
# Base similarity threshold (0.80-0.98). Higher = stricter matching
SEMANTIC_CACHE_THRESHOLD=0.92
# Cache TTL in seconds (default: 1 hour)
SEMANTIC_CACHE_TTL=3600
# Enable/disable semantic caching entirely
SEMANTIC_CACHE_ENABLED=true
# Enable adaptive threshold tuning based on hit rate
SEMANTIC_CACHE_ADAPTIVE=true
# Enable category-specific thresholds (greeting, email_search, calendar, etc.)
SEMANTIC_CACHE_CATEGORY_THRESHOLDS=true

# ===== MEM0 LONG-TERM MEMORY (Prisma + pgvector) =====
# Enable/disable long-term memory features (26% accuracy improvement)
MEM0_ENABLED=true
# Maximum memories to retrieve per query
MEM0_MAX_MEMORIES=10
# Note: Uses existing MISTRAL_API_KEY for embeddings

# ===== DEADLINE EXTRACTION (chrono-node NLP + BullMQ) =====
# Enable/disable deadline extraction from emails
DEADLINE_EXTRACTION_ENABLED=true
# Batch size for processing (>1000 users)
DEADLINE_BATCH_SIZE=50
# Minimum confidence for deadline extraction (0-1)
DEADLINE_MIN_CONFIDENCE=0.5

# Prompt Security (OWASP A04 - Insecure Design)
AI_PROMPT_MAX_LENGTH=10000
AI_PROMPT_MAX_TOTAL_LENGTH=100000
AI_PROMPT_STRIP_SYSTEM=true
AI_PROMPT_STRIP_CODE=false
AI_PROMPT_ESCAPE_TOKENS=true

# ===== RATE LIMITING (Redis-based, works across instances) =====
# Default rate limit: 10 requests per 60 seconds
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
# Lockout after 5 failed attempts for 15 minutes (900 seconds)
RATE_LIMIT_LOCKOUT_THRESHOLD=5
RATE_LIMIT_LOCKOUT_SECONDS=900

# ===== EMAIL PROVIDER (SMTP) =====
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply
SMTP_FROM_DOMAIN=mailagent.local

# ===== EXTERNAL SERVICES =====
STT_PROVIDER=google
TTS_PROVIDER=piper
GOOGLE_STT_API_KEY=your-google-cloud-key
PIPER_LANGUAGE=it_IT

# ===== FRONTEND CONFIG =====
FRONTEND_URL=http://localhost:3001
# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:3001
# Optional: regex patterns for dynamic origins (ngrok, vercel preview)
# CORS_ALLOWED_REGEX=
# Set to true to allow all origins (NOT recommended for production)
# CORS_ALLOW_ALL=false

# ===== NGROK TUNNEL (Optional - for OAuth callbacks in dev) =====
# Get your auth token from: https://dashboard.ngrok.com/get-started/your-authtoken
# IMPORTANT: Never commit your actual token! Use .env file only.
# NGROK_AUTHTOKEN=your-ngrok-auth-token-here
# NGROK_URL=https://your-subdomain.ngrok-free.app
# To start ngrok: docker compose --profile tunnel up

# ===== FEATURE FLAGS =====
EMAIL_SYNC_WORKERS_ENABLED=true
EMAIL_SYNC_SCHEDULER_ENABLED=true
CONTACTS_SYNC_ENABLED=true
CONTACTS_SYNC_SCHEDULER_ENABLED=true
JOBS_ENABLED=true
CALENDAR_SYNC_ENABLED=true
# WARNING: Set to false in production (logs sensitive auth data)
DEBUG_AUTH_LOG=false
# Advanced feature flags
FEATURE_USER_LABELS=false
FEATURE_USER_LABELS_ROLLOUT=0
FEATURE_USER_LABELS_TENANTS=

# ===== Embedding Worker Tuning =====
EMBEDDING_CONCURRENCY=8
EMBEDDING_RATE_MAX=25
EMBEDDING_RATE_DURATION_MS=1000
EMBEDDING_BULK_SIZE=75
EMBEDDING_FLUSH_MS=100
EMBEDDING_LOCK_MS=180000

# ===== Gmail Sync Caps/Retry =====
# Gmail API Limits (2025):
# - batchModify: up to 1000 messages per request
# - batchGet: recommended 50-100 for optimal performance
# - Rate limit: 10 requests/second per user (can increase to 50/s)
# @see https://developers.google.com/workspace/gmail/api/reference/quota
GMAIL_FULL_MAX_MESSAGES=200
GMAIL_BATCH_GET_SIZE=100
GMAIL_HISTORY_MAX_PAGES=25
GMAIL_RETRY_MAX_ATTEMPTS=3
GMAIL_RETRY_429_DELAY_MS=2000
GMAIL_RETRY_5XX_DELAY_MS=2000
# Bulk operation batch size (batchModify limit is 1000, we use 900 for safety)
# Backend handles chunking automatically in email-sync-back.service.ts
GMAIL_BULK_BATCH_SIZE=900

# ===== Microsoft Sync Caps/Retry =====
# Microsoft Graph API Limits (2025):
# - JSON batch: maximum 20 requests per batch (STRICT LIMIT)
# - Outlook concurrency: 4 parallel requests per mailbox
# - Rate limit: 10,000 requests per 10 minutes
# @see https://learn.microsoft.com/en-us/graph/throttling-limits
MS_FULL_MAX_MESSAGES=200
MS_BATCH_FETCH_SIZE=20
MS_RETRY_MAX_ATTEMPTS=3
MS_RETRY_429_DELAY_MS=2000
MS_RETRY_5XX_DELAY_MS=2000
# Bulk operation batch size (Graph batch limit is 20)
# Backend handles chunking automatically in email-sync-back.service.ts
MS_BULK_BATCH_SIZE=20

# ===== Queue Settings =====
QUEUE_HIGH_ATTEMPTS=3
QUEUE_HIGH_BACKOFF_MS=5000
QUEUE_HIGH_REMOVE_ON_COMPLETE_COUNT=50
QUEUE_HIGH_REMOVE_ON_COMPLETE_AGE=3600
QUEUE_HIGH_REMOVE_ON_FAIL_COUNT=100
QUEUE_NORMAL_ATTEMPTS=2
QUEUE_NORMAL_BACKOFF_MS=10000
QUEUE_LOW_ATTEMPTS=1
# Sync worker lock tuning
SYNC_WORKER_LOCK_MS=300000
SYNC_WORKER_STALLED_INTERVAL_MS=120000

# ===== Contacts Sync Queue Settings =====
CONTACTS_SYNC_WORKER_LOCK_MS=120000
CONTACTS_SYNC_WORKER_STALLED_INTERVAL_MS=60000
CONTACTS_QUEUE_HIGH_ATTEMPTS=3
CONTACTS_QUEUE_NORMAL_ATTEMPTS=3
CONTACTS_QUEUE_LOW_ATTEMPTS=2

# ===== Realtime =====
REALTIME_EMAIL_BUFFER_MS=200
REALTIME_EMAIL_BUFFER_MAX=500
REALTIME_SUPPRESS_MESSAGE_EVENTS=false
REALTIME_FOLDER_BUFFER_MS=1000
REALTIME_FOLDER_BUFFER_MAX=1000

# ===== Cross Provider Priority =====
CROSS_PROVIDER_PRIORITY_JSON={"google":1,"microsoft":2,"generic":3}

# ===== File Storage (S3/Minio) =====
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9100
# IMPORTANT: Change these for production!
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=mailagent-attachments
S3_FORCE_PATH_STYLE=true

# ===== IMAP Defaults (Generic Providers) =====
# IMAP Connection Limits (varies by provider):
# - Gmail IMAP: 15 concurrent connections per account
# - Microsoft 365 IMAP: ~3 concurrent SMTP connections
# - Generic providers: typically 5-10 connections
# @see https://support.google.com/mail/answer/7126229
IMAP_HOST=imap.local
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
# Maximum concurrent IMAP connections per provider
IMAP_MAX_CONCURRENT=5
