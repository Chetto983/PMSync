# PMSync Backend Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ===== ENVIRONMENT =====
NODE_ENV=development
LOG_LEVEL=debug

# ===== LOGGING =====
# Directory for log files (default: ./logs)
# LOG_DIR=./logs
# Enable verbose request logging (default: false)
# LOG_REQUESTS=false

# ===== SERVER =====
API_PORT=3000
API_HOST=localhost
# Public URL for OAuth callbacks and webhooks
API_PUBLIC_URL=http://localhost:3000
# Trust proxy settings for reverse proxy (nginx/traefik)
# Options: "loopback,linklocal,uniquelocal", true, false, or specific IPs
TRUST_PROXY=loopback,linklocal,uniquelocal
# Rate limiting (requests per time window)
RATE_LIMIT_MAX=300
RATE_LIMIT_TTL_MS=60000

# ===== DATABASE =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=mailuser
DB_PASSWORD=your-strong-password-here
DB_NAME=pmsync
# Full connection URL (for Prisma - use localhost for local dev)
# connection_limit: max connections per instance (default: num_cpus * 2 + 1)
# pool_timeout: seconds to wait for connection from pool (default: 10)
DATABASE_URL=postgresql://mailuser:your-strong-password-here@localhost:5432/pmsync?connection_limit=50&pool_timeout=20
# Railway alias (set automatically in Railway, or set to same value as DATABASE_URL)
# POSTGRES_URL=

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379
# IMPORTANT: Set password for production! Docker dev default: pmsync_dev_redis
REDIS_PASSWORD=pmsync_dev_redis
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY_MS=1000
# Separate DB for query embedding cache (optional)
REDIS_QUERY_CACHE_DB=1
# Redis TLS (for production Redis providers like Upstash)
# REDIS_TLS_ENABLED=false
# REDIS_TLS_REJECT_UNAUTHORIZED=true
# REDIS_TLS_CA=
# REDIS_TLS_CERT=
# REDIS_TLS_KEY=

# ===== BETTER-AUTH (Phase 50) =====
# MUST match the frontend BETTER_AUTH_SECRET exactly (shared session signing)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-must-match-frontend
# better-auth base URL (usually same as API_PUBLIC_URL)
BETTER_AUTH_URL=http://localhost:3000
# Public browser-facing auth URL for OAuth callbacks (/api/auth/* proxy on frontend)
BETTER_AUTH_PUBLIC_URL=http://localhost:3001

# ===== AUTH MISC =====
OTP_EXPIRATION=900000
PASSWORD_RESET_EXPIRATION=900000

# ===== CSRF Protection (SEC-04) =====
# Generate with: openssl rand -hex 32
# Falls back to BETTER_AUTH_SECRET if not set
CSRF_SECRET=change-me-in-production

# ===== ENCRYPTION =====
# IMPORTANT: Generate strong keys for production!
# Generate with: openssl rand -base64 32
AES_SECRET_KEY=default-key-change-in-production
# Field-level encryption (for PII fields)
# FIELD_ENCRYPTION_MASTER_KEY=generate-with-openssl-rand-base64-32
# Comma-separated list of old keys for key rotation (decrypt-only)
# FIELD_ENCRYPTION_OLD_KEYS=

# ===== OAUTH2 CREDENTIALS (Gmail/Google) =====
# Get these from Google Cloud Console
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
# Redirect URI is derived from API_PUBLIC_URL: ${API_PUBLIC_URL}/auth/gmail/callback
# Only set explicitly if you need a different URL:
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

# Google Cloud Pub/Sub topic (format: projects/{project-id}/topics/{topic-name})
# Create this topic in your Google Cloud Console
GOOGLE_PUBSUB_TOPIC=projects/your-project-id/topics/your-topic-name

# ===== OAUTH2 CREDENTIALS (Microsoft) =====
# Get these from Azure Portal (App Registrations)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
# Redirect URI is derived from API_PUBLIC_URL: ${API_PUBLIC_URL}/auth/microsoft/callback
# Only set explicitly if you need a different URL:
# MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
# Drift minutes for webhook subscription renewal (default: 60)
# MICROSOFT_RENEWAL_DRIFT_MINUTES=60

# ===== WEBHOOK CONFIGURATION =====
# Webhook URLs are derived from API_PUBLIC_URL automatically:
# - Email: ${API_PUBLIC_URL}/webhooks/microsoft/notifications
# - Calendar: ${API_PUBLIC_URL}/webhooks/calendar/microsoft/notifications
# - Contacts: ${API_PUBLIC_URL}/webhooks/contacts/microsoft/notifications
WEBHOOK_CLIENT_STATE=pmsync-ms-calendar
# Tokens for webhook/worker authentication (generate with: openssl rand -hex 32)
# EMAIL_SYNC_WEBHOOK_TOKEN=your-webhook-token
# EMAIL_SYNC_WORKER_TOKEN=your-worker-token

# ===== AI PROVIDER (Mistral) =====
MISTRAL_API_KEY=your-mistral-api-key
# Optional: custom API base URL
# MISTRAL_API_BASE_URL=https://api.mistral.ai
# MISTRAL_HEALTH_TIMEOUT_MS=3000

# ===== AI Configuration =====
AI_EMBEDDING_MODEL=mistral-embed

# Model tiers for different tasks (cost optimization)
# See: backend/src/config/ai.config.ts
AI_MODEL_SIMPLE=mistral-small-latest
AI_MODEL_COMPLEX=mistral-large-latest
AI_MODEL_CREATIVE=labs-mistral-small-creative
AI_MODEL_ROUTER=ministral-3b-latest

# HITL (Human-in-the-Loop) settings
AI_AUTO_APPROVE_THRESHOLD=0.9
AI_ACTION_EXPIRATION=24
AI_MAX_PENDING_ACTIONS=50

# Feature kill switches
# DISABLE_AI=false
# DISABLE_EMBEDDINGS=false

# Batch API (50% cost reduction for bulk operations)
MISTRAL_BATCH_ENABLED=true
MISTRAL_BATCH_EMBEDDING_MIN_SIZE=100
MISTRAL_BATCH_TRIAGE_MIN_SIZE=10

# Prompt Security (OWASP A04 - Insecure Design)
AI_PROMPT_MAX_LENGTH=10000
AI_PROMPT_MAX_TOTAL_LENGTH=100000
AI_PROMPT_STRIP_SYSTEM=true
AI_PROMPT_STRIP_CODE=false
AI_PROMPT_ESCAPE_TOKENS=true

# Cost Protection
AI_DAILY_COST_CAP=50.00
AI_COST_ALERT_EMAIL=billing@pmsync.local
AI_COST_ALERT_THRESHOLD=0.8

# ===== EMAIL PROVIDER (SMTP) =====
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply
SMTP_FROM_DOMAIN=pmsync.local

# ===== EXTERNAL SERVICES =====
STT_PROVIDER=google
TTS_PROVIDER=piper
GOOGLE_STT_API_KEY=your-google-cloud-key
PIPER_LANGUAGE=it_IT

# ===== FRONTEND CONFIG =====
FRONTEND_URL=http://localhost:3001
# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:3001
# Optional: regex patterns for dynamic origins (vercel preview)
# CORS_ALLOWED_REGEX=
# Set to true to allow all origins (NOT recommended for production)
# CORS_ALLOW_ALL=false

# ===== FEATURE FLAGS =====
EMAIL_SYNC_WORKERS_ENABLED=true
EMAIL_SYNC_SCHEDULER_ENABLED=true
CONTACTS_SYNC_ENABLED=true
CONTACTS_SYNC_SCHEDULER_ENABLED=true
JOBS_ENABLED=true
CALENDAR_SYNC_ENABLED=true
# WARNING: Set to false in production (logs sensitive auth data)
DEBUG_AUTH_LOG=false
# Advanced feature flags
FEATURE_USER_LABELS=false
FEATURE_USER_LABELS_ROLLOUT=0
FEATURE_USER_LABELS_TENANTS=

# ===== Email Module Settings =====
# EMAIL_LIST_MAX_LIMIT=100
# EMAIL_CONVERSATION_LIMIT=50
# EMAIL_MAX_ATTACHMENT_SIZE=26214400
# EMAIL_MAX_BULK_SIZE=100
# EMAIL_BULK_RATE_LIMIT=10
# EMAIL_SEND_RATE_LIMIT=30
# EMAIL_TRASH_PURGE_DAYS=30
# EMAIL_ORPHAN_RETRY_DAYS=7

# ===== Embedding Worker Tuning =====
# Concurrency: 1 = sequential (safest), higher = parallel (risk rate limits)
EMBEDDING_CONCURRENCY=1
# Rate limit: Mistral API allows 6 RPS (paid tier), using 2 for safety margin
EMBEDDING_RATE_MAX=2
EMBEDDING_RATE_DURATION_MS=1000
# Batch settings
EMBEDDING_BULK_SIZE=50
EMBEDDING_FLUSH_MS=200
EMBEDDING_LOCK_MS=180000
# Rate limit backoff settings (in milliseconds)
EMBEDDING_RATE_LIMIT_BASE_DELAY_MS=5000
EMBEDDING_RATE_LIMIT_MAX_DELAY_MS=120000

# ===== Embedding Backfill Scheduler =====
EMBEDDING_BACKFILL_ENABLED=true
EMBEDDING_BACKFILL_BATCH_SIZE=50
EMBEDDING_BACKFILL_INTERVAL_MS=600000

# ===== Gmail Sync Caps =====
# Gmail API Limits: batchGet 50-100, Rate limit 10 req/s per user
# @see https://developers.google.com/workspace/gmail/api/reference/quota
GMAIL_FULL_MAX_MESSAGES=200
GMAIL_BATCH_GET_SIZE=100

# ===== Microsoft Sync Caps =====
# Microsoft Graph API: JSON batch max 20, concurrency 4 per mailbox
# @see https://learn.microsoft.com/en-us/graph/throttling-limits
MS_FULL_MAX_MESSAGES=200
MS_BATCH_FETCH_SIZE=20

# ===== Sync Worker Settings =====
SYNC_WORKER_LOCK_MS=300000
SYNC_WORKER_STALLED_INTERVAL_MS=120000

# ===== Realtime =====
REALTIME_EMAIL_BUFFER_MS=200
REALTIME_EMAIL_BUFFER_MAX=500
REALTIME_FOLDER_BUFFER_MS=1000
REALTIME_FOLDER_BUFFER_MAX=1000

# ===== IMAP Settings (Generic Providers) =====
IMAP_HOST=imap.local
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
# IMAP connection pool tuning
# IMAP_MAX_CONNECTIONS_PER_USER=3
# IMAP_CONNECTION_IDLE_TIMEOUT_MS=300000
# IMAP_CONNECTION_ACQUIRE_TIMEOUT_MS=30000
# IMAP_MAX_MESSAGE_SIZE=52428800
# IMAP_MAX_MESSAGE_BODY_SIZE=10485760
# IMAP_BODY_DOWNLOAD_TIMEOUT_MS=30000

# ===== File Storage (S3/Minio) =====
S3_ENDPOINT=http://localhost:9100
# IMPORTANT: Change these for production!
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=pmsync-attachments
S3_FORCE_PATH_STYLE=true

# ===== AUTUMN BILLING =====
# Get keys from https://useautumn.com/
AUTUMN_SECRET_KEY=sk_test_xxx

# ===== WebAuthn / Passkeys =====
# PASSKEY_RP_ID=localhost

# ===== Startup Diagnostics (development only) =====
# STARTUP_TRAP_WARN_AFTER_MS=10000
# STARTUP_TRAP_ABORT_AFTER_MS=60000
# STARTUP_TRAP_REPEAT_MS=5000
# STARTUP_TRAP_TRACE_DI=false
# STARTUP_TRAP_TRACE_DI_SLOW_MS=500
# STARTUP_TRAP_DISABLE_BUFFER_LOGS=false

# ===== Worker Redis Timeouts =====
# BASE_WORKER_REDIS_CONNECT_TIMEOUT_MS=10000
# CACHE_REDIS_CONNECT_TIMEOUT_MS=5000

# ===== Garbage Collection =====
# GC_THRESHOLD_MB=512
