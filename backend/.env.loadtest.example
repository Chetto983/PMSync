# Load-test environment — copy to backend/.env.loadtest and fill in real values.
# NEVER commit .env.loadtest.

# Target URL (Railway staging preferred; production ONLY if explicitly approved)
LOADTEST_TARGET=https://pmsync-backend-staging.up.railway.app

# Shared password for all seeded loadtest+N@pmsync.local users
LOADTEST_PASSWORD=change-me-before-running

# Socket.IO auth token — generate via seed script (outputs a test JWT)
LOADTEST_TOKEN=issued-by-seed-script

# Tenant ID to isolate all load-test data. Created by seed script.
LOADTEST_TENANT_ID=loadtest-tenant

# Phase selector — used by scripts only (Artillery config has the phase schedule hard-coded)
LOADTEST_PHASE=100

# Required for the seed script (better-auth bootstrap reads from these)
DATABASE_URL=postgresql://...staging-or-local-only...
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=https://pm-sync-chetto1983s-projects.vercel.app
BETTER_AUTH_SECRET=any-32-char-secret-for-seed-process
# These can be dummy values for the seed (verification-email send fails silently per better-auth.instance.ts:422)
SENDGRID_API_KEY=dummy-for-seed
SMTP_FROM_EMAIL=loadtest
