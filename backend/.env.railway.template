# =====================================================
# Railway Environment Variables Template
# Set these in Railway Dashboard > Variables
# =====================================================

# ===== ENVIRONMENT =====
NODE_ENV=production
LOG_LEVEL=info

# ===== SERVER =====
# PORT is set automatically by Railway — do NOT set it manually
API_PUBLIC_URL=https://<your-railway-domain>.up.railway.app
BETTER_AUTH_URL=https://<your-railway-domain>.up.railway.app
BETTER_AUTH_PUBLIC_URL=https://<your-vercel-domain>.vercel.app

# ===== DATABASE (Railway PostgreSQL plugin) =====
# Railway injects POSTGRES_* variables automatically when you add the Postgres plugin
# Use the internal URL for service-to-service communication (no SSL needed)
DATABASE_URL=postgresql://postgres:<password>@postgres.railway.internal:5432/railway?connection_limit=20&pool_timeout=20
# Or use Railway reference variables:
# DATABASE_URL=${{Postgres.DATABASE_URL}}?connection_limit=20&pool_timeout=20

# ===== REDIS (Railway Redis plugin) =====
# Railway injects REDIS_URL automatically when you add the Redis plugin
# Parse into components or use REDIS_URL directly
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
REDIS_DB=0
# Railway Redis private/proxy endpoints use plain TCP (TLS here can block startup)
REDIS_TLS_ENABLED=false

# ===== AUTH =====
BETTER_AUTH_SECRET=<generate: openssl rand -base64 32>
OTP_EXPIRATION=900000
PASSWORD_RESET_EXPIRATION=900000
CSRF_SECRET=<generate: openssl rand -hex 64>

# ===== WebAuthn / Passkeys =====
PASSKEY_RP_ID=<your-frontend-domain>
WEBAUTHN_ORIGIN=https://<your-frontend-domain>
# Legacy alias supported by runtime, but prefer PASSKEY_RP_ID going forward:
# WEBAUTHN_RP_ID=<your-frontend-domain>

# ===== ENCRYPTION =====
AES_SECRET_KEY=<generate: openssl rand -base64 32>

# ===== OAUTH2 CREDENTIALS (Gmail/Google) =====
GMAIL_CLIENT_ID=<from Google Cloud Console>
GMAIL_CLIENT_SECRET=<from Google Cloud Console>
# GOOGLE_REDIRECT_URI — defaults to ${FRONTEND_URL}/api/auth/callback/google (shared with better-auth)
# Only set if you need a custom override
GOOGLE_PUBSUB_TOPIC=<your GCP pubsub topic>

# ===== OAUTH2 CREDENTIALS (Microsoft) =====
MICROSOFT_CLIENT_ID=<from Azure AD>
MICROSOFT_CLIENT_SECRET=<from Azure AD>
# MICROSOFT_REDIRECT_URI — defaults to ${FRONTEND_URL}/api/auth/callback/microsoft (shared with better-auth)
# Only set if you need a custom override
MICROSOFT_TENANT_ID=common

# ===== WEBHOOK CONFIGURATION =====
WEBHOOK_CLIENT_STATE=<random string>
EMAIL_SYNC_WEBHOOK_TOKEN=<generate: openssl rand -hex 32>
EMAIL_SYNC_WORKER_TOKEN=<generate: openssl rand -hex 32>

# ===== AI PROVIDER (Mistral) =====
MISTRAL_API_KEY=<your Mistral API key>

# ===== AI Configuration =====
AI_EMBEDDING_MODEL=mistral-embed
AI_MODEL_SIMPLE=mistral-small-latest
AI_MODEL_COMPLEX=mistral-large-latest
AI_MODEL_CREATIVE=labs-mistral-small-creative
AI_MODEL_ROUTER=ministral-3b-latest
AI_MODEL_REASONING=magistral-small-latest
AI_QUEUE_CONCURRENCY=5
AI_CONCURRENT_LIMIT=5
UNIFIED_KNOWLEDGE_ENABLED=true
AI_ACTION_EXPIRATION=24
AI_MAX_PENDING_ACTIONS=50
AI_PROMPT_MAX_LENGTH=10000
AI_PROMPT_MAX_TOTAL_LENGTH=100000
AI_PROMPT_STRIP_SYSTEM=true
AI_PROMPT_STRIP_CODE=false
AI_PROMPT_ESCAPE_TOKENS=true

# ===== EMAIL PROVIDER (SendGrid) =====
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=<your SendGrid API key>
SMTP_FROM_EMAIL=<your from email>
SMTP_FROM_DOMAIN=<your domain>

# ===== FRONTEND CONFIG =====
FRONTEND_URL=https://<your-vercel-domain>.vercel.app
CORS_ALLOWED_ORIGINS=https://<your-vercel-domain>.vercel.app

# ===== FEATURE FLAGS =====
EMAIL_SYNC_WORKERS_ENABLED=true
EMAIL_SYNC_SCHEDULER_ENABLED=true
CONTACTS_SYNC_ENABLED=true
CONTACTS_SYNC_SCHEDULER_ENABLED=true
JOBS_ENABLED=true
CALENDAR_SYNC_ENABLED=true

# ===== Full Sync Caps =====
# Initial backfill budget per provider account.
GMAIL_FULL_MAX_MESSAGES=10000
MS_FULL_MAX_MESSAGES=10000

# ===== File Storage (Cloudflare R2) =====
S3_ENDPOINT=<your R2 endpoint>
S3_ACCESS_KEY=<your R2 access key>
S3_SECRET_KEY=<your R2 secret key>
S3_REGION=auto
S3_BUCKET=pmsync
S3_FORCE_PATH_STYLE=true

# ===== COST PROTECTION =====
AI_DAILY_COST_CAP=50.00
AI_MONTHLY_COST_CAP=1500.00
AI_COST_ALERT_EMAIL=admin@pmsync.dev
AI_COST_ALERT_THRESHOLD=0.8
