/// Unified email analysis from single LLM call (replaces 11 agents)
model EmailAnalysis {
  id       String @id @default(cuid())
  emailId  String @unique
  tenantId String

  // Classification (1 LLM call output)
  priority  EmailPriority @default(NORMAL)
  category  EmailCategory @default(OTHER)
  sentiment Sentiment     @default(NEUTRAL)

  // Extracted Data
  hasDeadline   Boolean   @default(false)
  deadlineDate  DateTime?
  needsFollowUp Boolean   @default(false)
  followUpDate  DateTime?

  // CRM Signals
  isSalesLead  Boolean     @default(false)
  dealSignal   DealSignal?
  buyingIntent Float? // 0-1 score

  // Actions Suggested
  suggestedActions Json @default("[]") // ActionSuggestion[]

  // Summary
  summary   String?  @db.Text
  keyPoints String[] @default([])

  // Processing Metadata
  processedAt DateTime @default(now())
  modelUsed   String   @default("gpt-4o-mini")
  tokensUsed  Int      @default(0)
  latencyMs   Int      @default(0)

  // Relations
  email  Email  @relation(fields: [emailId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, processedAt])
  @@index([tenantId, priority])
  @@index([tenantId, needsFollowUp])
  @@map("email_analyses")
}

enum EmailPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum EmailCategory {
  SALES_INQUIRY
  SUPPORT_REQUEST
  MEETING_REQUEST
  FOLLOW_UP
  NEWSLETTER
  AUTOMATED
  PERSONAL
  OTHER
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  URGENT
}

enum DealSignal {
  NEW_LEAD
  INTEREST_SHOWN
  OBJECTION
  NEGOTIATION
  READY_TO_BUY
  CHURNING
}

/// HITL Action Queue - AI suggested actions awaiting approval
model ActionQueue {
  id       String  @id @default(cuid())
  tenantId String
  userId   String
  emailId  String?

  // Action Details
  actionType    ActionType
  actionPayload Json // Type-specific payload

  // AI Confidence
  confidence Float   @default(0)
  reasoning  String? @db.Text

  // HITL Status
  status         ActionStatus @default(PENDING_APPROVAL)
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?

  // Execution
  executedAt      DateTime?
  executionResult Json?
  executionError  String?
  retryCount      Int       @default(0)

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  email  Email? @relation(fields: [emailId], references: [id], onDelete: SetNull)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, userId, status])
  @@index([expiresAt])
  @@map("action_queue")
}

enum ActionType {
  SEND_EMAIL
  SCHEDULE_MEETING
  CREATE_TASK
  UPDATE_CONTACT
  UPDATE_DEAL
  ADD_LABEL
  ARCHIVE_EMAIL
  SNOOZE_EMAIL
}

enum ActionStatus {
  PENDING_APPROVAL
  APPROVED
  AUTO_APPROVED
  REJECTED
  EXECUTED
  FAILED
  EXPIRED
}

/// CRM Deal pipeline for sellers
model Deal {
  id        String @id @default(cuid())
  tenantId  String
  userId    String
  contactId String

  // Deal Info
  name        String
  value       Float  @default(0)
  currency    String @default("USD")
  stage       String @default("LEAD")
  probability Float  @default(0)

  // Dates
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?

  // Source
  sourceEmailId String?
  sourceChannel String  @default("email")

  // Status
  status     DealStatus @default(OPEN)
  lostReason String?

  // Metadata
  notes        String? @db.Text
  customFields Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contact    Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activities DealActivity[]

  @@index([tenantId, userId])
  @@index([tenantId, stage])
  @@index([tenantId, status])
  @@map("deals")
}

enum DealStatus {
  OPEN
  WON
  LOST
}

