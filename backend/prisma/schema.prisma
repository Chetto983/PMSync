  latencyMs        Int         @default(0)
  toolCallCount    Int         @default(0)
  hitlRequired     Boolean     @default(false)
  requestId        String?     // Correlation ID from X-Request-Id header (Phase 33)
  status           AiRunStatus @default(SUCCESS)
  errorCode        String?
  errorMessage     String?
  promptVersion    String?     // Correlate cost changes to prompt changes
  qualityScore     Float?      // 0.0-1.0 retroactive quality rating (NeMo evaluator)
  qualityMethod    String?     // 'schema-completeness', 'user-action'
  rawContextTokens       Int?  // Token count before context assembly
  assembledContextTokens Int?  // Token count after context assembly
  createdAt        DateTime    @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@index([tenantId, runType])
  @@map("ai_run_ledger")
}

/// ========================================================================
/// Follow-Up AI — Smart Reminder System con Telegram
/// User-initiated reminders with natural language parsing, email monitoring,
/// and Telegram notifications at configurable time slots.
/// ========================================================================

enum ReminderPeriodo {
  mattina
  pomeriggio
  sera
  tutto_il_giorno
}

enum ReminderAzione {
  chiama
  scrivi_mail
  verifica
  conferma
  controlla
  altro
}

enum ReminderPriorita {
  alta
  media
  bassa
}

enum ReminderCondizioneTipo {
  sempre
  se_risponde_mail
  se_non_risponde_mail
  manuale
}

enum ReminderStatus {
  attivo
  completato
  annullato
  sospeso
}

model Reminder {
  id                  String                @id @default(cuid())
  tenantId            String
  userId              String

  // Content
  titolo              String
  descrizione         String?
  contatto            String?

  // Deadline
  scadenzaTesto       String?               // Raw user input: "Lunedi pomeriggio"
  scadenzaDatetime    DateTime?             // Computed by AI parser
  periodo             ReminderPeriodo?

  // Action & priority
  azione              ReminderAzione        @default(altro)
  priorita            ReminderPriorita      @default(media)

  // Conditional logic
  condizioneTipo      ReminderCondizioneTipo @default(sempre)
  condizioneDettaglio String?

  // Email monitoring
  monitoraEmail       Boolean               @default(false)
  emailKeywords       String[]              @default([])
  emailMittente       String?
  emailRilevata       Boolean               @default(false)
  emailRilevataAt     DateTime?

  // Telegram notification
  messaggioTelegram   String?
  telegramInviato     Boolean               @default(false)
  telegramInviatoAt   DateTime?

  // Status
  status              ReminderStatus        @default(attivo)
  completatoAt        DateTime?

  // AI debug
  inputUtente         String?
  aiRawResponse       Json?

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  // Relations
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, userId, status])
  @@index([tenantId, monitoraEmail, status])
  @@index([scadenzaDatetime])
  @@index([status, updatedAt])
  @@map("reminders")
}

model TelegramSettings {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String   @unique

  telegramChatId     String?
  isActive           Boolean  @default(false)

  // AI chat conversation ID (persists chat history across Telegram messages)
  aiConversationId   String?

  // Notification slot times (HH:mm format)
  slotMattina        String   @default("08:30")
  slotPomeriggio     String   @default("14:00")
  slotSera           String   @default("18:00")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiConversation     AiConversation? @relation(fields: [aiConversationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("telegram_settings")
}

model TelegramLog {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String

  reminderIds       String[]
  slot              String
  messaggioCompleto String
  inviatoAt         DateTime @default(now())
  isError           Boolean  @default(false)
  errorMessage      String?

  // Relations
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, inviatoAt])
  @@map("telegram_logs")
}

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, endpoint])
  @@index([tenantId, userId])
  @@map("push_subscriptions")
}

// ============================================================
// CRM Models — Phase 1 Core CRM
// ============================================================

model CrmAccount {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  website     String?
  industry    String?
  size        String?      // "1-10", "11-50", "51-200", "201-500", "500+"
  revenue     Decimal?     @db.Decimal(15, 2)
  currency    String?      @default("EUR")
  address     Json?        // { street, city, state, zip, country }
  phone       String?
  description String?
  parentId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      CrmAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    CrmAccount[] @relation("AccountHierarchy")
  contacts    AccountContact[]
  deals       CrmDeal[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, industry])
  @@index([tenantId, parentId])
  @@map("crm_accounts")
}

model CrmPipeline {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isDefault   Boolean    @default(false)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages      CrmStage[]
  deals       CrmDeal[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("crm_pipelines")
}

model CrmStage {
  id          String      @id @default(cuid())
  pipelineId  String
  name        String
  position    Int
  probability Int         @default(0) // 0-100 win probability
  color       String?     @default("#6B7280")
  isWon       Boolean     @default(false)
  isLost      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  pipeline    CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       CrmDeal[]

  @@unique([pipelineId, name])
  @@unique([pipelineId, position])
  @@index([pipelineId])
  @@map("crm_stages")
}

model CrmDeal {
  id                String        @id @default(cuid())
  tenantId          String
  pipelineId        String
  stageId           String
  accountId         String?
  name              String
  amount            Decimal?      @db.Decimal(15, 2)
  currency          String        @default("EUR")
  expectedCloseDate DateTime?
  closedAt          DateTime?
  priority          String?       @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  source            String?       // WEBSITE, REFERRAL, COLD_CALL, etc.
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline          CrmPipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage             CrmStage      @relation(fields: [stageId], references: [id], onDelete: Restrict)
  account           CrmAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  activities        CrmActivity[]
  dealProducts      DealProduct[]
  dealContacts      DealContact[]

  @@index([tenantId])
  @@index([tenantId, pipelineId])
  @@index([tenantId, stageId])
  @@index([tenantId, accountId])
  @@index([tenantId, expectedCloseDate])
  @@map("crm_deals")
}

model CrmActivity {
  id        String   @id @default(cuid())
  tenantId  String
  dealId    String
  type      String   // STAGE_CHANGE, NOTE, EMAIL, CALL, MEETING, TASK
  content   String?
  metadata  Json?    // { fromStage, toStage } for STAGE_CHANGE, etc.
  createdAt DateTime @default(now())

  deal      CrmDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([tenantId, dealId, createdAt])
  @@map("crm_activities")
}

model CrmProduct {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  description String?
  price       Decimal       @db.Decimal(15, 2)
  currency    String        @default("EUR")
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dealProducts DealProduct[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("crm_products")
}

model DealProduct {
  id        String     @id @default(cuid())
  dealId    String
  productId String
  quantity  Int        @default(1)
  unitPrice Decimal    @db.Decimal(15, 2)
  discount  Decimal    @default(0) @db.Decimal(5, 2) // percentage 0-100
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  deal      CrmDeal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product   CrmProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([dealId, productId])
  @@index([dealId])
  @@map("crm_deal_products")
}

/// Join table: CrmAccount <-> Contact (with role metadata)
model AccountContact {
  id        String     @id @default(cuid())
  accountId String
  contactId String
  tenantId  String
  role      String?    // "Decision Maker", "Technical Contact", "Billing", etc.
  isPrimary Boolean    @default(false)
  createdAt DateTime   @default(now())

  account   CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact   Contact    @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([accountId, contactId, tenantId])
  @@index([accountId])
  @@index([contactId, tenantId])
  @@map("crm_account_contacts")
}

/// Join table: CrmDeal <-> Contact (with role metadata)
model DealContact {
  id        String   @id @default(cuid())
  dealId    String
  contactId String
  tenantId  String
  role      String?  // "Buyer", "Influencer", "Champion", etc.
  createdAt DateTime @default(now())

  deal      CrmDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([dealId, contactId, tenantId])
  @@index([dealId])
  @@index([contactId, tenantId])
  @@map("crm_deal_contacts")
}

/// ========================================================================
/// Graph RAG — Entity Graph (Phase 109)
/// Adjacency-list graph model for multi-hop RAG traversal.
/// Nodes represent entities (contacts, emails, topics, etc.),
/// edges represent typed relationships between them.
/// ========================================================================

model GraphNode {
  id         String                 @id @default(cuid())
  tenantId   String
  nodeType   String                 // 'contact', 'email', 'thread', 'calendar_event', 'topic', 'memory'
  externalId String?                // FK to source record (emailId, contactId, etc.)
  label      String                 // Display name / subject / topic name
  metadata   Json                   @default("{}")
  vector     Unsupported("vector")? // Optional 1024-dim embedding
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  outEdges   GraphEdge[]            @relation("EdgeSource")
  inEdges    GraphEdge[]            @relation("EdgeTarget")

  @@index([tenantId])
  @@index([tenantId, nodeType])
  @@index([tenantId, externalId])
  @@index([label(ops: raw("gin_trgm_ops"))], map: "graph_nodes_label_gin_idx", type: Gin)
  @@map("graph_nodes")
}

model GraphEdge {
  id        String    @id @default(cuid())
  tenantId  String
  sourceId  String
  targetId  String
  edgeType  String    // 'sent', 'received', 'mentions', 'replies_to', 'about', 'attended', 'anchored_to'
  weight    Float     @default(1.0)
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source    GraphNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target    GraphNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceId, targetId, edgeType])
  @@index([tenantId])
  @@index([sourceId])
  @@index([targetId])
  @@index([tenantId, edgeType])
  @@index([sourceId, edgeType])
  @@map("graph_edges")
}
