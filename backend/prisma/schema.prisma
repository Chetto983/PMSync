/// Follow-up type classification (FOLLOW-01)
enum FollowUpType {
  WAITING_FOR // I sent email, waiting for response
  TODO        // I received email, need to take action
}

/// Tracks emails that need follow-up
model EmailFollowUp {
  id             String         @id @default(cuid())
  tenantId       String
  userId         String
  emailId        String
  status         FollowUpStatus @default(PENDING)
  followUpType   FollowUpType   @default(TODO)
  reason         String?
  dueDate        DateTime
  remindCount    Int            @default(0)
  lastRemindedAt DateTime?
  resolvedAt     DateTime?
  resolvedBy     String?
  // Extraction data (2026-01-30)
  commitments      Json?          // Array of ExtractedCommitment
  waitingFor       Json?          // Array of ExtractedWaitingFor
  actionItems      Json?          // Array of ExtractedActionItem
  emailType        String?        // receipt|notification|request|conversation|newsletter|alert
  confidence       Float?         // LLM confidence score (0.0-1.0)
  // NLP deadline detection (2026-02-07 Phase 04-02)
  detectedDeadline DateTime?      // NLP-extracted deadline from email text (chrono-node)
  deadlineSource   String?        // "nlp" | "manual" | "extraction"
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  email          Email          @relation(fields: [emailId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([emailId, tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, userId, status])
  @@index([tenantId, userId, followUpType])
  @@index([dueDate])
  @@map("email_follow_ups")
}

