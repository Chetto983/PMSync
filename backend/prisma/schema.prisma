generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  description          String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  actionQueue          ActionQueue[]
  auditLogs            AuditLog[]
  calendarEvents       CalendarEvent[]
  deals                Deal[]
  emailAnalyses        EmailAnalysis[]
  emails               Email[]
  embeddings           Embedding[]
  folders              Folder[]
  providerConfigs      ProviderConfig[]
  providerContacts     ProviderContact[]     @relation("ProviderContactToTenant")
  scheduledEmails      ScheduledEmail[]
  subscription         Subscription?
  contacts             Contact[]             @relation("ContactToTenant")
  userLabels           UserLabel[]
  users                User[]
  webhookSubscriptions WebhookSubscription[]
  emailSignatures      EmailSignature[]

  @@map("tenants")
}

model User {
  id                  String               @id @default(cuid())
  tenantId            String
  email               String
  passwordHash        String
  firstName           String?
  lastName            String?
  role                String               @default("user")
  isActive            Boolean              @default(true)
  isMfaEnabled        Boolean              @default(true)
  lastLogin           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  actionQueue         ActionQueue[]
  auditLogs           AuditLog[]
  dashboardPreference DashboardPreference?
  deals               Deal[]
  mfaBackupCodes      MfaBackupCode[]
  mfaSecret           MfaSecret?
  sessions            Session[]
  trustedDevices      TrustedDevice[]
  userPreferences     UserPreferences?
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webauthnCredentials WebAuthnCredential[]
  writingStyleProfile WritingStyleProfile?
  emailSignatures     EmailSignature[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model UserPreferences {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  folderOrders                Json?
  sidebarSmartFiltersExpanded Boolean  @default(true)
  sidebarLabelsExpanded       Boolean  @default(true)
  theme                       String?  @default("light")
  language                    String?  @default("en")
  timezone                    String?  @default("UTC")
  emailDensity                String?  @default("comfortable")
  aiSmartRepliesEnabled       Boolean  @default(true)
  aiSummarizationEnabled      Boolean  @default(true)
  aiSchedulingEnabled         Boolean  @default(true)
  aiAutoApproveThreshold      Float?   @default(0.9)
  jobTitle                    String?
  jobRole                     String?  @default("OTHER")
  department                  String?
  industry                    String?
  companySize                 String?  @default("SMB")
  communicationStyle          String?  @default("CASUAL")
  responseLength              String?  @default("MODERATE")
  workingHoursStart           String?  @default("09:00")
  workingHoursEnd             String?  @default("18:00")
  workingDays                 String[] @default(["MON", "TUE", "WED", "THU", "FRI"])
  proactivityLevel            String?  @default("MEDIUM")
  notificationFrequency       String?  @default("DIGEST")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_preferences")
}

model DashboardPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dashboard_preferences")
}

/// TOTP secrets for authenticator apps (Google Authenticator, Authy, etc.)
model MfaSecret {
  id           String    @id @default(cuid())
  userId       String    @unique
  secret       String
  encryptionIv String
  isEnabled    Boolean   @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_secrets")
}

/// Backup/recovery codes for MFA emergency access
model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isUsed])
  @@map("mfa_backup_codes")
}

/// Trusted devices for "Keep me signed in" feature
model TrustedDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceToken String   @unique
  deviceName  String?
  deviceHash  String
  ipAddress   String?
  location    String?
  expiresAt   DateTime
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceToken])
  @@index([expiresAt])
  @@map("trusted_devices")
}

/// WebAuthn/Passkey credentials for passwordless authentication
/// Supports Face ID, Touch ID, Windows Hello, and security keys (YubiKey)
model WebAuthnCredential {
  id                   String   @id @default(cuid())
  userId               String
  credentialId         String   @unique
  credentialPublicKey  String
  counter              Int      @default(0)
  credentialDeviceType String   @default("singleDevice")
  credentialBackedUp   Boolean  @default(false)
  transports           String[] @default([])
  aaguid               String?
  deviceName           String?
  lastUsedAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, token])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userEmail String
  token     String   @unique
  tenantId  String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model ProviderConfig {
  id                       String                @id @default(cuid())
  tenantId                 String
  userId                   String?
  providerType             String
  email                    String
  displayName              String?
  supportsEmail            Boolean               @default(true)
  supportsCalendar         Boolean               @default(false)
  supportsContacts         Boolean               @default(false)
  accessToken              String?
  refreshToken             String?
  tokenEncryptionIv        String?
  tokenExpiresAt           DateTime?
  imapHost                 String?
  imapPort                 Int?
  imapUsername             String?
  imapPassword             String?
  imapEncryptionIv         String?
  imapUseTls               Boolean               @default(true)
  smtpHost                 String?
  smtpPort                 Int?
  smtpUsername             String?
  smtpPassword             String?
  smtpEncryptionIv         String?
  smtpUseTls               Boolean               @default(true)
  caldavUrl                String?
  caldavUsername           String?
  caldavPassword           String?
  caldavEncryptionIv       String?
  carddavUrl               String?
  carddavUsername          String?
  carddavPassword          String?
  carddavEncryptionIv      String?
  metadata                 Json?
  isDefault                Boolean               @default(false)
  isActive                 Boolean               @default(true)
  lastSyncedAt             DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  avgActivityRate          Float?                @default(0.0)
  syncPriority             Int?                  @default(3)
  nextSyncAt               DateTime?
  emailsReceivedLast24h    Int?                  @default(0)
  errorStreak              Int?                  @default(0)
  lastActivityCheck        DateTime?
  refreshTokenEncryptionIv String?
  scope                    String?
  calendarEvents           CalendarEvent[]
  calendarSyncStates       CalendarSyncState[]
  emails                   Email[]
  folders                  Folder[]
  tenant                   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerContacts         ProviderContact[]     @relation("ProviderContactToProvider")
  scheduledEmails          ScheduledEmail[]
  webhookSubscriptions     WebhookSubscription[]
  emailSignatures          EmailSignature[]

  @@unique([tenantId, email, providerType])
  @@index([tenantId, isDefault])
  @@index([userId])
  @@index([nextSyncAt, isActive])
  @@index([syncPriority, nextSyncAt])
  @@map("provider_configs")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Email {
  id                   String                  @id @default(cuid())
  tenantId             String
  providerId           String
  externalId           String
  threadId             String?
  messageId            String?
  inReplyTo            String?
  references           String?
  from                 String
  to                   String[]
  cc                   String[]                @default([])
  bcc                  String[]                @default([])
  replyTo              String?
  subject              String
  bodyText             String?
  bodyHtml             String?
  snippet              String?
  folder               String                  @default("INBOX")
  labels               String[]                @default([])
  isRead               Boolean                 @default(false)
  isStarred            Boolean                 @default(false)
  isFlagged            Boolean                 @default(false)
  isDraft              Boolean                 @default(false)
  isDeleted            Boolean                 @default(false)
  isArchived           Boolean                 @default(false)
  sentAt               DateTime
  receivedAt           DateTime
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  size                 Int?
  headers              Json?
  metadata             Json?
  crossProviderLinkId  String?
  hasCalendarInvite    Boolean                 @default(false)
  calendarInviteData   Json?
  calendarInviteStatus String?
  calendarEventId      String?
  userModifiedAt       DateTime?
  version              Int                     @default(1)
  isBodyFetched        Boolean                 @default(false)
  actionQueue          ActionQueue[]
  analysis             EmailAnalysis?
  attachments          EmailAttachment[]
  followUp             EmailFollowUp?
  emailLabels          EmailLabel[]
  crossProviderLink    EmailCrossProviderLink? @relation(fields: [crossProviderLinkId], references: [id])
  provider             ProviderConfig          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  embeddings           Embedding[]

  @@unique([tenantId, messageId, folder])
  @@unique([providerId, externalId]) // Required for upsert operations
  @@index([tenantId, folder, receivedAt])
  @@index([tenantId, isRead])
  @@index([tenantId, threadId])
  @@index([sentAt])
  @@index([crossProviderLinkId])
  @@index([tenantId, hasCalendarInvite])
  @@index([tenantId, providerId, folder, receivedAt])
  @@index([tenantId, isStarred, receivedAt])
  @@index([tenantId, providerId, isDeleted])
  @@index([providerId, folder, isRead])
  @@index([tenantId, from])
  @@index([tenantId, isBodyFetched])
  @@index([tenantId, isFlagged])
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([from(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([providerId, folder, isRead, isDeleted])
  @@map("emails")
}

model ScheduledEmail {
  id           String         @id @default(cuid())
  tenantId     String
  providerId   String
  to           String[]
  cc           String[]       @default([])
  bcc          String[]       @default([])
  subject      String
  bodyHtml     String
  bodyText     String
  inReplyTo    String?
  references   String?
  attachments  Json?
  scheduledAt  DateTime
  status       String         @default("pending")
  errorMessage String?
  retryCount   Int            @default(0)
  sentAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  provider     ProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, scheduledAt])
  @@index([scheduledAt, status])
  @@map("scheduled_emails")
}

model Folder {
  id           String         @id @default(cuid())
  tenantId     String
  providerId   String
  name         String
  path         String
  externalId   String?
  delimiter    String         @default("/")
  parentId     String?
  level        Int            @default(0)
  isSelectable Boolean        @default(true)
  specialUse   String?
  attributes   String[]       @default([])
  totalCount   Int            @default(0)
  unreadCount  Int            @default(0)
  recentCount  Int            @default(0)
  unseenCount  Int            @default(0)
  uidValidity  String?
  uidNext      Int?           @default(0)
  syncToken    String?
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  isSystem     Boolean        @default(false)
  parent       Folder?        @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[]       @relation("FolderHierarchy")
  provider     ProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([providerId, path])
  @@index([providerId, externalId])
  @@index([tenantId, providerId])
  @@index([tenantId, specialUse])
  @@index([tenantId, isSystem])
  @@index([providerId, parentId])
  @@index([lastSyncedAt])
  @@map("folders")
}

model UserLabel {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  type        LabelType    @default(USER)
  color       Json?
  icon        String?
  parentId    String?
  level       Int          @default(0)
  orderIndex  Int          @default(0)
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  emailLabels EmailLabel[]
  parent      UserLabel?   @relation("LabelHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    UserLabel[]  @relation("LabelHierarchy")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, type])
  @@index([tenantId, parentId])
  @@index([tenantId, orderIndex])
  @@map("user_labels")
}

model EmailLabel {
  id        String    @id @default(cuid())
  emailId   String
  labelId   String
  createdAt DateTime  @default(now())
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)
  label     UserLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([emailId, labelId])
  @@index([emailId])
  @@index([labelId])
  @@index([createdAt])
  @@map("email_labels")
}

model EmailAttachment {
  id          String   @id @default(cuid())
  emailId     String
  filename    String
  mimeType    String
  size        Int
  contentId   String?
  storageType String   @default("local")
  storagePath String?
  contentHash String?
  isInline    Boolean  @default(false)
  createdAt   DateTime @default(now())
  email       Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@map("email_attachments")
}

model EmailCrossProviderLink {
  id               String    @id @default(cuid())
  tenantId         String
  contentHash      String
  conflictStrategy String    @default("LAST_WRITE_WINS")
  mergedIsRead     Boolean   @default(false)
  mergedIsStarred  Boolean   @default(false)
  mergedFolder     String    @default("INBOX")
  mergedLabels     String[]  @default([])
  providerCount    Int       @default(0)
  lastSyncedAt     DateTime  @default(now())
  lastConflictAt   DateTime?
  lastConflict     Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  emails           Email[]

  @@unique([tenantId, contentHash])
  @@index([tenantId, lastSyncedAt])
  @@index([contentHash])
  @@map("email_cross_provider_links")
}

model Embedding {
  id             String                 @id @default(cuid())
  tenantId       String
  documentName   String?
  content        String
  /// Mistral-embed produces 1024-dimensional vectors
  vector         Unsupported("vector")?
  embeddingModel String                 @default("mistral-embed")
  metadata       Json?
  createdAt      DateTime               @default(now())
  emailId        String?
  email          Email?                 @relation(fields: [emailId], references: [id], onDelete: Cascade)
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([emailId])
  @@map("embeddings")
}

model CalendarEvent {
  id               String                    @id @default(cuid())
  tenantId         String
  providerId       String
  externalId       String
  calendarId       String?
  iCalUID          String?
  title            String
  description      String?
  location         String?
  organizer        String?
  attendees        Json?
  startTime        DateTime
  endTime          DateTime
  isAllDay         Boolean                   @default(false)
  timeZone         String                    @default("UTC")
  recurrence       String[]                  @default([])
  recurringEventId String?
  status           String                    @default("confirmed")
  visibility       String                    @default("default")
  isDeleted        Boolean                   @default(false)
  isCancelled      Boolean                   @default(false)
  reminders        Json?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  metadata         Json?
  htmlLink         String?
  lastSyncedAt     DateTime                  @default(now())
  syncVersion      Int                       @default(1)
  calendarName     String?
  attachments      CalendarEventAttachment[]
  provider         ProviderConfig            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalId])
  @@index([tenantId, startTime])
  @@index([tenantId, calendarId, startTime])
  @@index([tenantId, providerId, startTime])
  @@index([iCalUID])
  @@index([tenantId, title])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("calendar_events")
}

model CalendarEventAttachment {
  id            String        @id @default(cuid())
  eventId       String
  filename      String
  mimeType      String
  size          Int
  storageType   String        @default("s3")
  storagePath   String?
  fileUrl       String?
  fileId        String?
  iconLink      String?
  isGoogleDrive Boolean       @default(false)
  isOneDrive    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  event         CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("calendar_event_attachments")
}

/// CalendarPreference - User preferences for calendars (color, visibility)
/// Stores UI preferences that persist across sessions
model CalendarPreference {
  id          String   @id @default(cuid())
  tenantId    String
  providerId  String
  calendarId  String
  color       String?
  isVisible   Boolean  @default(true)
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, providerId, calendarId])
  @@index([tenantId])
  @@index([providerId])
  @@map("calendar_preferences")
}

/// CalendarSyncState - Per-calendar sync tokens for incremental sync
/// Stores Google syncToken and Microsoft deltaLink for efficient calendar syncing
/// Reduces API calls by ~95% after initial full sync
model CalendarSyncState {
  id                String         @id @default(cuid())
  providerId        String
  calendarId        String
  calendarName      String?
  syncToken         String?
  deltaLink         String?
  lastFullSyncAt    DateTime?
  lastIncrementalAt DateTime?
  fullSyncRequired  Boolean        @default(true)
  consecutiveErrors Int            @default(0)
  lastError         String?
  lastErrorAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  provider          ProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, calendarId])
  @@index([providerId])
  @@index([fullSyncRequired])
  @@map("calendar_sync_states")
}

model Contact {
  id                  String               @id @default(cuid())
  tenantId            String
  displayName         String?
  firstName           String?
  lastName            String?
  middleName          String?
  nickname            String?
  prefix              String?
  suffix              String?
  emails              Json?
  phoneNumbers        Json?
  addresses           Json?
  company             String?
  jobTitle            String?
  department          String?
  birthday            DateTime?
  anniversary         DateTime?
  websites            Json?
  socialProfiles      Json?
  notes               String?
  tags                String[]             @default([])
  photoUrl            String?
  photoEtag           String?
  isDeleted           Boolean              @default(false)
  isStarred           Boolean              @default(false)
  isFavorite          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  metadata            Json?
  lastInteractedAt    DateTime?
  receivedCount       Int                  @default(0)
  reconnectRemindedAt DateTime?
  relationshipScore   Float?
  sentCount           Int                  @default(0)
  totalInteractions   Int                  @default(0)
  contactInteractions ContactInteraction[]
  deals               Deal[]
  providerContacts    ProviderContact[]
  tenant              Tenant               @relation("ContactToTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, displayName])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, company])
  @@index([tenantId, displayName, firstName, lastName, company])
  @@index([tenantId, lastInteractedAt])
  @@index([tenantId, relationshipScore])
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("unified_contacts")
}

model ProviderContact {
  id             String         @id @default(cuid())
  contactId      String
  tenantId       String
  providerId     String
  externalId     String
  contactGroup   String?
  rawData        Json?
  firstName      String?
  lastName       String?
  middleName     String?
  displayName    String?
  nickname       String?
  prefix         String?
  suffix         String?
  emails         Json?
  phoneNumbers   Json?
  addresses      Json?
  company        String?
  jobTitle       String?
  department     String?
  birthday       DateTime?
  anniversary    DateTime?
  websites       Json?
  socialProfiles Json?
  notes          String?
  photoUrl       String?
  photoEtag      String?
  vCardVersion   String?        @default("4.0")
  lastSyncedAt   DateTime       @default(now())
  syncVersion    Int            @default(1)
  eTag           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  metadata       Json?
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  provider       ProviderConfig @relation("ProviderContactToProvider", fields: [providerId], references: [id], onDelete: Cascade)
  tenant         Tenant         @relation("ProviderContactToTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalId])
  @@index([contactId])
  @@index([tenantId])
  @@index([tenantId, displayName])
  @@index([contactGroup])
  @@map("provider_contacts")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String
  changes   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model JobQueue {
  id          String    @id @default(cuid())
  tenantId    String
  jobId       String
  jobType     String
  status      String    @default("pending")
  data        Json
  result      Json?
  error       String?
  retries     Int       @default(0)
  maxRetries  Int       @default(3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([tenantId, status])
  @@index([createdAt])
  @@map("job_queue")
}

model WebhookSubscription {
  id                 String         @id @default(cuid())
  providerId         String
  providerType       String
  subscriptionId     String
  webhookUrl         String?
  resourcePath       String         @default("generic")
  isActive           Boolean        @default(true)
  expiresAt          DateTime
  lastRenewedAt      DateTime       @default(now())
  metadata           Json?
  lastNotificationAt DateTime?
  notificationCount  Int            @default(0)
  errorCount         Int            @default(0)
  lastError          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  tenantId           String
  provider           ProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([providerId, resourcePath])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([providerId, isActive])
  @@index([expiresAt])
  @@index([providerType])
  @@index([subscriptionId])
  @@map("webhook_subscriptions")
}

model HealthCheck {
  id            String   @id @default(cuid())
  service       String   @unique
  status        String   @default("up")
  lastCheckedAt DateTime @default(now())
  responseTime  Int?
  error         String?

  @@map("health_checks")
}

model WritingStyleProfile {
  id                  String   @id @default(cuid())
  tenantId            String
  userId              String   @unique
  avgSentenceLength   Float    @default(15)
  avgParagraphLines   Float    @default(3)
  avgWordsPerEmail    Int      @default(100)
  bulletListRate      Float    @default(0)
  formalityScore      Float    @default(0.5)
  contractionRate     Float    @default(0.3)
  emojiRate           Float    @default(0)
  typeTokenRatio      Float    @default(0.5)
  exclamationRate     Float    @default(0)
  questionRate        Float    @default(0)
  ellipsisRate        Float    @default(0)
  greetingPresent     Boolean  @default(true)
  preferredGreetings  String[] @default([])
  signOffPresent      Boolean  @default(true)
  preferredSignOffs   String[] @default([])
  sentimentPolarity   Float    @default(0)
  empathyPhraseRate   Float    @default(0)
  hedgeRate           Float    @default(0)
  sampleCount         Int      @default(0)
  lastAnalyzedEmailId String?
  lastAnalyzed        DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, userId])
  @@map("writing_style_profiles")
}

/// Email signatures - per-provider signatures with default support
model EmailSignature {
  id         String          @id @default(cuid())
  tenantId   String
  userId     String
  providerId String?         // null = applies to all providers
  name       String
  content    String          // HTML content
  isDefault  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   ProviderConfig? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId])
  @@index([tenantId, userId, providerId])
  @@index([providerId])
  @@map("email_signatures")
}

/// User AI memories - facts, preferences, patterns learned from conversations
model AIMemory {
  id         String                 @id @default(cuid())
  tenantId   String
  userId     String
  content    String
  memoryType MemoryType             @default(FACT)
  source     String?
  confidence Float                  @default(0.5)
  usageCount Int                    @default(0)
  lastUsedAt DateTime?
  category   String?
  tags       String?
  metadata   Json?
  expiresAt  DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  /// Semantic vector for similarity search (mistral-embed: 1024 dimensions)
  vector     Unsupported("vector")?
  history    AIMemoryHistory[]

  @@index([tenantId, userId])
  @@index([tenantId, userId, memoryType])
  @@index([tenantId, userId, category])
  @@index([content(ops: raw("gin_trgm_ops"))], map: "ai_memories_content_gin_idx", type: Gin)
  @@index([vector], map: "ai_memories_vector_hnsw_idx")
  @@map("ai_memories")
}

/// Change history for memories (audit trail)
model AIMemoryHistory {
  id        String   @id @default(cuid())
  memoryId  String
  action    String
  oldValue  String?
  newValue  String?
  changedBy String?
  createdAt DateTime @default(now())
  memory    AIMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@map("ai_memory_history")
}

/// Tracks emails that need follow-up
model EmailFollowUp {
  id             String         @id @default(cuid())
  tenantId       String
  userId         String
  emailId        String         @unique
  status         FollowUpStatus @default(PENDING)
  reason         String?
  dueDate        DateTime
  remindCount    Int            @default(0)
  lastRemindedAt DateTime?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  email          Email          @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, userId, status])
  @@index([dueDate])
  @@map("email_follow_ups")
}

/// Tracks contact interaction history for relationship intelligence (P1.7)
model ContactInteraction {
  id           String                 @id @default(cuid())
  tenantId     String
  contactId    String
  type         ContactInteractionType
  date         DateTime
  summary      String?
  sentiment    String?
  sourceType   String?
  sourceId     String?
  createdAt    DateTime               @default(now())
  contactEmail String?
  contactName  String?
  emailId      String?                @unique
  userId       String
  contact      Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId])
  @@index([tenantId, contactId, date])
  @@index([tenantId, userId])
  @@index([tenantId, userId, date])
  @@index([emailId])
  @@map("contact_interactions")
}

/// User document libraries for RAG queries
model DocumentLibrary {
  id               String            @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  documentCount    Int               @default(0)
  totalSize        Int               @default(0)
  isDeleted        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  mistralLibraryId String?
  documents        LibraryDocument[]

  @@unique([tenantId, name])
  @@index([tenantId, isDeleted])
  @@index([mistralLibraryId])
  @@map("document_libraries")
}

/// Documents within a library (stored in Mistral Libraries API)
model LibraryDocument {
  id                String          @id @default(cuid())
  libraryId         String
  filename          String
  mimeType          String?
  size              Int
  status            String          @default("processing")
  isDeleted         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  mistralDocumentId String?
  library           DocumentLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([libraryId, isDeleted])
  @@index([status])
  @@index([mistralDocumentId])
  @@map("library_documents")
}

/// Unified email analysis from single LLM call (replaces 11 agents)
model EmailAnalysis {
  id               String        @id @default(cuid())
  emailId          String        @unique
  tenantId         String
  priority         EmailPriority @default(NORMAL)
  category         EmailCategory @default(OTHER)
  sentiment        Sentiment     @default(NEUTRAL)
  hasDeadline      Boolean       @default(false)
  deadlineDate     DateTime?
  needsFollowUp    Boolean       @default(false)
  followUpDate     DateTime?
  isSalesLead      Boolean       @default(false)
  dealSignal       DealSignal?
  buyingIntent     Float?
  suggestedActions Json          @default("[]")
  summary          String?
  keyPoints        String[]      @default([])
  processedAt      DateTime      @default(now())
  modelUsed        String        @default("gpt-4o-mini")
  tokensUsed       Int           @default(0)
  latencyMs        Int           @default(0)
  email            Email         @relation(fields: [emailId], references: [id], onDelete: Cascade)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, processedAt])
  @@index([tenantId, priority])
  @@index([tenantId, needsFollowUp])
  @@map("email_analyses")
}

/// HITL Action Queue - AI suggested actions awaiting approval
model ActionQueue {
  id              String       @id @default(cuid())
  tenantId        String
  userId          String
  emailId         String?
  actionType      ActionType
  actionPayload   Json
  confidence      Float        @default(0)
  reasoning       String?
  status          ActionStatus @default(PENDING_APPROVAL)
  approvedBy      String?
  approvedAt      DateTime?
  rejectedReason  String?
  executedAt      DateTime?
  executionResult Json?
  executionError  String?
  retryCount      Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  expiresAt       DateTime?
  email           Email?       @relation(fields: [emailId], references: [id])
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, userId, status])
  @@index([expiresAt])
  @@map("action_queue")
}

/// CRM Deal pipeline for sellers
model Deal {
  id                String         @id @default(cuid())
  tenantId          String
  userId            String
  contactId         String
  name              String
  value             Float          @default(0)
  currency          String         @default("USD")
  stage             String         @default("LEAD")
  probability       Float          @default(0)
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  sourceEmailId     String?
  sourceChannel     String         @default("email")
  status            DealStatus     @default(OPEN)
  lostReason        String?
  notes             String?
  customFields      Json           @default("{}")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  activities        DealActivity[]
  contact           Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, stage])
  @@index([tenantId, status])
  @@map("deals")
}

/// Deal activity log
model DealActivity {
  id           String           @id @default(cuid())
  dealId       String
  emailId      String?
  activityType DealActivityType
  description  String?
  metadata     Json             @default("{}")
  createdAt    DateTime         @default(now())
  deal         Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("deal_activities")
}

/// Subscription management (Autumn integration)
model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  autumnCustomerId     String?            @unique
  autumnSubscriptionId String?            @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  monthlyEmailLimit    Int                @default(100)
  monthlyAICallLimit   Int                @default(50)
  maxUsers             Int                @default(1)
  emailsProcessed      Int                @default(0)
  aiCallsUsed          Int                @default(0)
  usageResetAt         DateTime           @default(now())
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model voltagent_memory_conversations {
  id                        String                      @id
  resource_id               String
  user_id                   String
  title                     String
  metadata                  Json
  created_at                DateTime                    @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at                DateTime                    @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  voltagent_memory_messages voltagent_memory_messages[]
  voltagent_memory_steps    voltagent_memory_steps[]

  @@index([resource_id], map: "idx_voltagent_memory_conversations_resource_id")
  @@index([user_id], map: "idx_voltagent_memory_conversations_user_id")
}

model voltagent_memory_messages {
  conversation_id                String
  message_id                     String
  user_id                        String
  role                           String
  parts                          Json?
  metadata                       Json?
  format_version                 Int?                           @default(2)
  created_at                     DateTime                       @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  voltagent_memory_conversations voltagent_memory_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([conversation_id, message_id])
  @@index([conversation_id], map: "idx_voltagent_memory_messages_conversation_id")
  @@index([created_at], map: "idx_voltagent_memory_messages_created_at")
}

model voltagent_memory_steps {
  id                             String                         @id
  conversation_id                String
  user_id                        String
  agent_id                       String
  agent_name                     String?
  operation_id                   String?
  step_index                     Int
  type                           String
  role                           String
  content                        String?
  arguments                      Json?
  result                         Json?
  usage                          Json?
  sub_agent_id                   String?
  sub_agent_name                 String?
  created_at                     DateTime                       @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  voltagent_memory_conversations voltagent_memory_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, step_index], map: "idx_voltagent_memory_steps_conversation")
  @@index([conversation_id, operation_id], map: "idx_voltagent_memory_steps_operation")
}

model voltagent_memory_users {
  id         String   @id
  metadata   Json?
  created_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model voltagent_memory_workflow_states {
  id              String   @id
  workflow_id     String
  workflow_name   String
  status          String
  suspension      Json?
  events          Json?
  output          Json?
  cancellation    Json?
  user_id         String?
  conversation_id String?
  metadata        Json?
  created_at      DateTime @db.Timestamptz(6)
  updated_at      DateTime @db.Timestamptz(6)

  @@index([status], map: "idx_voltagent_memory_workflow_states_status")
  @@index([workflow_id], map: "idx_voltagent_memory_workflow_states_workflow_id")
}

enum LabelType {
  SYSTEM
  USER
}

/// Memory type categories
enum MemoryType {
  PREFERENCE
  FACT
  PATTERN
  INTERACTION
  CONTACT_NOTE
}

enum FollowUpStatus {
  PENDING
  REMINDED
  RESOLVED
  EXPIRED
}

enum ContactInteractionType {
  EMAIL_SENT
  EMAIL_RECEIVED
  MEETING
  CALL
  NOTE
}

enum EmailPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum EmailCategory {
  SALES_INQUIRY
  SUPPORT_REQUEST
  MEETING_REQUEST
  FOLLOW_UP
  NEWSLETTER
  AUTOMATED
  PERSONAL
  OTHER
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  URGENT
}

enum DealSignal {
  NEW_LEAD
  INTEREST_SHOWN
  OBJECTION
  NEGOTIATION
  READY_TO_BUY
  CHURNING
}

enum ActionType {
  SEND_EMAIL
  SCHEDULE_MEETING
  CREATE_TASK
  UPDATE_CONTACT
  UPDATE_DEAL
  ADD_LABEL
  ARCHIVE_EMAIL
  SNOOZE_EMAIL
}

enum ActionStatus {
  PENDING_APPROVAL
  APPROVED
  AUTO_APPROVED
  REJECTED
  EXECUTED
  FAILED
  EXPIRED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum DealActivityType {
  EMAIL_RECEIVED
  EMAIL_SENT
  CALL_LOGGED
  MEETING_SCHEDULED
  STAGE_CHANGED
  NOTE_ADDED
  DEAL_CREATED
  DEAL_WON
  DEAL_LOST
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}
