generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                       String                    @id @default(cuid())
  name                     String
  slug                     String                    @unique
  description              String?
  metadata                 String?
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  actionFeedback           AgentActionFeedback[]
  learningProfiles         AgentLearningProfile[]
  auditLogs                AuditLog[]
  calendarEvents           CalendarEvent[]
  emailAnalyses            EmailAnalysis[]
  emailSignatures          EmailSignature[]
  emailTemplates           EmailTemplate[]
  emails                   Email[]
  embeddings               Embedding[]
  folders                  Folder[]
  providerConfigs          ProviderConfig[]
  providerContacts         ProviderContact[]         @relation("ProviderContactToTenant")
  scheduledEmails          ScheduledEmail[]
  subscription             Subscription?
  contacts                 Contact[]                 @relation("ContactToTenant")
  userLabels               UserLabel[]
  users                    User[]
  webhookSubscriptions     WebhookSubscription[]
  userPreferences          UserPreferences[]         @relation("UserPreferencesToTenant")
  dashboardPreferences     DashboardPreference[]     @relation("DashboardPreferenceToTenant")
  mfaSecrets               MfaSecret[]               @relation("MfaSecretToTenant")
  mfaBackupCodes           MfaBackupCode[]           @relation("MfaBackupCodeToTenant")
  emailLabels              EmailLabel[]              @relation("EmailLabelToTenant")
  emailAttachments         EmailAttachment[]         @relation("EmailAttachmentToTenant")
  calendarEventAttachments CalendarEventAttachment[] @relation("CalendarEventAttachmentToTenant")
  calendarSyncStates       CalendarSyncState[]       @relation("CalendarSyncStateToTenant")
  sessions                 Session[]
  trustedDevices           TrustedDevice[]
  webauthnCredentials      WebAuthnCredential[]
  mistralAgents            MistralAgent[]
  userConsents             UserConsent[]
  legalAcceptances         LegalAcceptance[]
  dataExportRequests       DataExportRequest[]
  aiConversations          AiConversation[]
  aiMemories               AIMemory[]
  members                  Member[]
  invitations              Invitation[]
  reminders                Reminder[]
  telegramLogs             TelegramLog[]
  pushSubscriptions        PushSubscription[]
  crmAccounts              CrmAccount[]
  crmPipelines             CrmPipeline[]
  crmDeals                 CrmDeal[]
  crmProducts              CrmProduct[]
  graphNodes               GraphNode[]
  graphEdges               GraphEdge[]

  @@map("tenants")
}

model User {
  id                  String                 @id @default(cuid())
  tenantId            String?
  email               String                 @unique
  name                String                 @default("")
  emailVerified       Boolean                @default(false)
  image               String?
  firstName           String?
  lastName            String?
  avatarUrl           String?
  role                String                 @default("member")
  isActive            Boolean                @default(true)
  twoFactorEnabled    Boolean                @default(false)
  onboardingComplete  Boolean                @default(false)
  banned              Boolean                @default(false)
  banReason           String?
  banExpires          DateTime?
  lastLogin           DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?
  actionFeedback      AgentActionFeedback[]
  learningProfiles    AgentLearningProfile[]
  auditLogs           AuditLog[]
  dashboardPreference DashboardPreference?
  emailSignatures     EmailSignature[]
  emailTemplates      EmailTemplate[]
  mfaBackupCodes      MfaBackupCode[]
  mfaSecret           MfaSecret?
  sessions            Session[]
  accounts            Account[]
  trustedDevices      TrustedDevice[]
  userPreferences     UserPreferences?
  tenant              Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webauthnCredentials WebAuthnCredential[]
  twoFactors          TwoFactor[]
  passkeys            Passkey[]
  writingStyleProfiles WritingStyleProfile[]
  userConsents        UserConsent[]
  legalAcceptances    LegalAcceptance[]
  dataExportRequests  DataExportRequest[]
  aiConversations     AiConversation[]
  members             Member[]
  sentInvitations     Invitation[]        @relation("InvitationInviter")
  reminders           Reminder[]
  telegramSettings    TelegramSettings?
  telegramLogs        TelegramLog[]
  pushSubscriptions   PushSubscription[]

  /// @deprecated Legacy compound unique -- email is now globally unique. Remove in Phase 58.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model UserPreferences {
  id                          String   @id @default(cuid())
  tenantId                    String
  userId                      String   @unique
  folderOrders                Json?
  sidebarSmartFiltersExpanded Boolean  @default(true)
  sidebarLabelsExpanded       Boolean  @default(true)
  theme                       String?  @default("light")
  language                    String?  @default("en")
  timezone                    String?  @default("UTC")
  emailDensity                String?  @default("comfortable")
  aiSmartRepliesEnabled       Boolean  @default(true)
  aiSummarizationEnabled      Boolean  @default(true)
  aiSchedulingEnabled         Boolean  @default(true)
  aiAutoApproveThreshold      Float?   @default(0.9)
  hitlSensitivity             String?  @default("HIGH_ONLY")
  aiAutoTriageEnabled         Boolean  @default(false) // Auto-label and prioritize new emails
  pushEmailEnabled            Boolean  @default(true)
  pushCalendarEnabled         Boolean  @default(true)
  pushAiEnabled               Boolean  @default(true)
  jobTitle                    String?
  jobRole                     String?  @default("OTHER")
  department                  String?
  industry                    String?
  companySize                 String?  @default("SMB")
  communicationStyle          String?  @default("CASUAL")
  responseLength              String?  @default("MODERATE")
  workingHoursStart           String?  @default("09:00")
  workingHoursEnd             String?  @default("18:00")
  workingDays                 String[] @default(["MON", "TUE", "WED", "THU", "FRI"])
  proactivityLevel            String?  @default("MEDIUM")
  notificationFrequency       String?  @default("DIGEST")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant                      Tenant   @relation("UserPreferencesToTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("user_preferences")
}

model DashboardPreference {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String   @unique
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation("DashboardPreferenceToTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("dashboard_preferences")
}

/// TOTP secrets for authenticator apps (Google Authenticator, Authy, etc.)
model MfaSecret {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String    @unique
  secret       String
  encryptionIv String
  isEnabled    Boolean   @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant    @relation("MfaSecretToTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("mfa_secrets")
}

/// Backup/recovery codes for MFA emergency access
model MfaBackupCode {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  codeHash  String
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation("MfaBackupCodeToTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, isUsed])
  @@index([tenantId])
  @@map("mfa_backup_codes")
}

/// Trusted devices for "Keep me signed in" feature
model TrustedDevice {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  deviceToken String
  deviceName  String?
  deviceHash  String
  ipAddress   String?
  location    String?
  expiresAt   DateTime
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, deviceToken])
  @@index([tenantId])
  @@index([userId])
  @@index([deviceToken])
  @@index([expiresAt])
  @@map("trusted_devices")
}

/// WebAuthn/Passkey credentials for passwordless authentication
/// Supports Face ID, Touch ID, Windows Hello, and security keys (YubiKey)
model WebAuthnCredential {
  id                   String   @id @default(cuid())
  tenantId             String
  userId               String
  credentialId         String
  credentialPublicKey  String
  counter              Int      @default(0)
  credentialDeviceType String   @default("singleDevice")
  credentialBackedUp   Boolean  @default(false)
  transports           String[] @default([])
  aaguid               String?
  deviceName           String?
  lastUsedAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, credentialId])
  @@index([tenantId])
  @@index([userId])
  @@map("webauthn_credentials")
}

/// better-auth twoFactor plugin table
model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor")
}

/// better-auth passkey plugin table
model Passkey {
  id           String   @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int      @default(0)
  deviceType   String
  backedUp     Boolean  @default(false)
  transports   String?
  aaguid       String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
  @@map("passkeys")
}

model Session {
  id                   String   @id @default(cuid())
  /// @deprecated Legacy field -- Session no longer scoped to tenant. Remove in Phase 58.
  tenantId             String?
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  impersonatedBy       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("admin")
  createdAt      DateTime @default(now())

  organization   Tenant   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String   @default("admin")
  status         String   @default("pending")
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization   Tenant   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User     @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
  @@map("invitation")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, providerId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userEmail String
  token     String   @unique
  tenantId  String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userEmail])
  @@index([expiresAt])
  @@index([tenantId])
  @@map("password_reset_tokens")
}

model ProviderConfig {
  id                       String                @id @default(cuid())
  tenantId                 String
  userId                   String?
  providerType             String
  email                    String
  displayName              String?
  supportsEmail            Boolean               @default(true)
  supportsCalendar         Boolean               @default(false)
  supportsContacts         Boolean               @default(false)
  accessToken              String?
  refreshToken             String?
  tokenEncryptionIv        String?
  tokenExpiresAt           DateTime?
  imapHost                 String?
  imapPort                 Int?
  imapUsername             String?
  imapPassword             String?
  imapEncryptionIv         String?
  imapUseTls               Boolean               @default(true)
  smtpHost                 String?
  smtpPort                 Int?
  smtpUsername             String?
  smtpPassword             String?
  smtpEncryptionIv         String?
  smtpUseTls               Boolean               @default(true)
  caldavUrl                String?
  caldavUsername           String?
  caldavPassword           String?
  caldavEncryptionIv       String?
  carddavUrl               String?
  carddavUsername          String?
  carddavPassword          String?
  carddavEncryptionIv      String?
  metadata                 Json?
  isDefault                Boolean               @default(false)
  isActive                 Boolean               @default(true)
  lastSyncedAt             DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  avgActivityRate          Float?                @default(0.0)
  syncPriority             Int?                  @default(3)
  nextSyncAt               DateTime?
  emailsReceivedLast24h    Int?                  @default(0)
  errorStreak              Int?                  @default(0)
  lastActivityCheck        DateTime?
  refreshTokenEncryptionIv String?
  scope                    String?
  calendarEvents           CalendarEvent[]
  calendarSyncStates       CalendarSyncState[]
  emailSignatures          EmailSignature[]
  emails                   Email[]
  folders                  Folder[]
  tenant                   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerContacts         ProviderContact[]     @relation("ProviderContactToProvider")
  scheduledEmails          ScheduledEmail[]
  webhookSubscriptions     WebhookSubscription[]
  writingStyleProfiles     WritingStyleProfile[]

  @@unique([tenantId, email, providerType])
  @@index([tenantId, isDefault])
  @@index([userId])
  @@index([nextSyncAt, isActive])
  @@index([syncPriority, nextSyncAt])
  @@map("provider_configs")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
/// Citus distributed table - composite PK for horizontal sharding
model Email {
  id                   String                  @default(cuid())
  tenantId             String
  providerId           String
  externalId           String
  threadId             String?
  messageId            String?
  inReplyTo            String?
  references           String?
  from                 String
  fromHash             String?
  to                   String[]
  cc                   String[]                @default([])
  bcc                  String[]                @default([])
  replyTo              String?
  subject              String
  bodyText             String?
  bodyHtml             String?
  snippet              String?
  folder               String                  @default("INBOX")
  labels               String[]                @default([])
  isRead               Boolean                 @default(false)
  isStarred            Boolean                 @default(false)
  isFlagged            Boolean                 @default(false)
  isDraft              Boolean                 @default(false)
  isDeleted            Boolean                 @default(false)
  isArchived           Boolean                 @default(false)
  sentAt               DateTime?
  receivedAt           DateTime
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  size                 Int?
  headers              Json?
  metadata             Json?
  hasCalendarInvite    Boolean                 @default(false)
  calendarInviteData   Json?
  calendarInviteStatus String?
  calendarEventId      String?
  userModifiedAt       DateTime?
  version              Int                     @default(1)
  isBodyFetched        Boolean                 @default(false)
  // Auto-Triage fields (Superhuman-like feature)
  aiPriority           Int? // AI-calculated priority 1-5 (1=highest)
  aiPriorityReason     String? // Explanation for priority
  aiSentiment          String? // AI sentiment: positive, negative, neutral, mixed
  aiLabels             String[]                @default([]) // AI-suggested labels
  isAutoTriaged        Boolean                 @default(false) // Flag if auto-triaged
  autoTriagedAt        DateTime? // When auto-triage ran
  analysis             EmailAnalysis?
  attachments          EmailAttachment[]
  followUp             EmailFollowUp?
  emailLabels          EmailLabel[]
  provider             ProviderConfig          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  embeddings           Embedding[]

  @@id([id, tenantId])
  @@unique([tenantId, messageId, folder])
  @@unique([providerId, externalId])
  @@index([tenantId, folder, receivedAt])
  @@index([tenantId, isRead])
  @@index([tenantId, threadId])
  @@index([sentAt])
  @@index([tenantId, hasCalendarInvite])
  @@index([tenantId, providerId, folder, receivedAt])
  @@index([tenantId, isStarred, receivedAt])
  @@index([tenantId, providerId, isDeleted])
  @@index([providerId, folder, isRead])
  @@index([tenantId, from])
  @@index([tenantId, fromHash])
  @@index([tenantId, isBodyFetched])
  @@index([tenantId, isFlagged])
  @@index([tenantId, aiPriority])
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([from(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([providerId, folder, isRead, isDeleted])
  @@index([tenantId, isDeleted, updatedAt])
  @@map("emails")
}

model ScheduledEmail {
  id           String         @id @default(cuid())
  tenantId     String
  providerId   String
  to           String[]
  cc           String[]       @default([])
  bcc          String[]       @default([])
  subject      String
  bodyHtml     String
  bodyText     String
  inReplyTo    String?
  references   String?
  attachments  Json?
  scheduledAt  DateTime
  status       String         @default("pending")
  errorMessage String?
  retryCount   Int            @default(0)
  sentAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  provider     ProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, scheduledAt])
  @@index([scheduledAt, status])
  @@map("scheduled_emails")
}

/// Citus distributed table - composite PK for horizontal sharding
model Folder {
  id           String         @default(cuid())
  tenantId     String
  providerId   String
  name         String
  path         String
  externalId   String?
  delimiter    String         @default("/")
  parentId     String?
  level        Int            @default(0)
  isSelectable Boolean        @default(true)
  specialUse   String?
  attributes   String[]       @default([])
  totalCount   Int            @default(0)
  unreadCount  Int            @default(0)
  recentCount  Int            @default(0)
  unseenCount  Int            @default(0)
  uidValidity  String?
  uidNext      Int?           @default(0)
  syncToken    String?
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  isSystem     Boolean        @default(false)
  parent       Folder?        @relation("FolderHierarchy", fields: [parentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  children     Folder[]       @relation("FolderHierarchy")
  provider     ProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([id, tenantId])
  @@unique([providerId, path])
  @@index([providerId, externalId])
  @@index([tenantId, providerId])
  @@index([tenantId, specialUse])
  @@index([tenantId, isSystem])
  @@index([providerId, parentId])
  @@index([lastSyncedAt])
  @@map("folders")
}

model UserLabel {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  type        LabelType    @default(USER)
  color       Json?
  icon        String?
  aiPrompt    String?      /// Natural language instruction for AI triage (e.g. "Urgent client requests needing response within 24h")
  parentId    String?
  level       Int          @default(0)
  orderIndex  Int          @default(0)
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  emailLabels EmailLabel[]
  parent      UserLabel?   @relation("LabelHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    UserLabel[]  @relation("LabelHierarchy")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, type])
  @@index([tenantId, parentId])
  @@index([tenantId, orderIndex])
  @@map("user_labels")
}

model EmailLabel {
  id        String    @id @default(cuid())
  tenantId  String
  emailId   String
  labelId   String
  createdAt DateTime  @default(now())
  email     Email     @relation(fields: [emailId, tenantId], references: [id, tenantId], onDelete: Cascade)
  label     UserLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation("EmailLabelToTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, emailId, labelId])
  @@index([emailId])
  @@index([labelId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("email_labels")
}

model EmailAttachment {
  id          String   @id @default(cuid())
  tenantId    String
  emailId     String
  filename    String
  mimeType    String
  size        Int
  contentId   String?
  storageType String   @default("local")
  storagePath String?
  contentHash String?
  isInline    Boolean  @default(false)
  createdAt   DateTime @default(now())
  email       Email    @relation(fields: [emailId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant      Tenant   @relation("EmailAttachmentToTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([tenantId])
  @@map("email_attachments")
}

/// Citus distributed table - composite PK for horizontal sharding
/// GDPR-compliant: No content stored - use emailId/contactId to fetch from source tables
/// Vectors are NOT reversible, so they're safe to store
model Embedding {
  id             String                 @default(cuid())
  tenantId       String
  documentName   String?
  /// Mistral-embed produces 1024-dimensional vectors
  vector         Unsupported("vector")?
  embeddingModel String                 @default("mistral-embed")
  metadata       Json?
  createdAt      DateTime               @default(now())
  emailId        String?
  contactId      String?
  email          Email?                 @relation(fields: [emailId, tenantId], references: [id, tenantId], onDelete: Cascade)
  contact        Contact?               @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([id, tenantId])
  @@index([tenantId])
  @@index([emailId])
  @@index([contactId])
  @@map("embeddings")
}

/// Citus distributed table - composite PK for horizontal sharding
model CalendarEvent {
  id               String                    @default(cuid())
  tenantId         String
  providerId       String
  externalId       String
  calendarId       String?
  iCalUID          String?
  title            String
  description      String?
  location         String?
  organizer        String?
  attendees        Json?
  startTime        DateTime
  endTime          DateTime
  isAllDay         Boolean                   @default(false)
  timeZone         String                    @default("UTC")
  recurrence       String[]                  @default([])
  recurringEventId String?
  status           String                    @default("confirmed")
  visibility       String                    @default("default")
  isDeleted        Boolean                   @default(false)
  isCancelled      Boolean                   @default(false)
  reminders        Json?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  metadata         Json?
  htmlLink         String?
  lastSyncedAt     DateTime                  @default(now())
