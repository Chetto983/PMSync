generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  description          String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  auditLogs            AuditLog[]
  calendarEvents       CalendarEvent[]
  contacts             Contact[]             @relation("ContactToTenant")
  providerContacts     ProviderContact[]     @relation("ProviderContactToTenant")
  emails               Email[]
  embeddings           Embedding[]
  folders              Folder[]
  providerConfigs      ProviderConfig[]
  scheduledEmails      ScheduledEmail[]
  users                User[]
  webhookSubscriptions WebhookSubscription[]
  userLabels           UserLabel[]

  // AI Refactor v2.0 relations
  emailAnalyses EmailAnalysis[]
  actionQueue   ActionQueue[]
  deals         Deal[]
  subscription  Subscription?

  @@map("tenants")
}

model User {
  id                  String               @id @default(cuid())
  tenantId            String
  email               String
  passwordHash        String
  firstName           String?
  lastName            String?
  role                String               @default("user")
  isActive            Boolean              @default(true)
  isMfaEnabled        Boolean              @default(true)
  lastLogin           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  auditLogs           AuditLog[]
  mfaSecret           MfaSecret?
  mfaBackupCodes      MfaBackupCode[]
  trustedDevices      TrustedDevice[]
  webauthnCredentials WebAuthnCredential[]
  sessions            Session[]
  userPreferences     UserPreferences?
  writingStyleProfile WritingStyleProfile?
  dashboardPreference DashboardPreference?
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // AI Refactor v2.0 relations (replaces AgentPendingAction, etc.)
  actionQueue ActionQueue[]
  deals       Deal[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model UserPreferences {
  id                          String  @id @default(cuid())
  userId                      String  @unique
  folderOrders                Json?
  sidebarSmartFiltersExpanded Boolean @default(true)
  sidebarLabelsExpanded       Boolean @default(true)
  theme                       String? @default("light")
  language                    String? @default("en")
  timezone                    String? @default("UTC")
  emailDensity                String? @default("comfortable")

  // AI Agent Preferences
  aiSmartRepliesEnabled  Boolean @default(true)
  aiSummarizationEnabled Boolean @default(true)
  aiSchedulingEnabled    Boolean @default(true)
  aiAutoApproveThreshold Float?  @default(0.9) // 0-1 confidence threshold for auto-approval

  // Personalization - Job/Role
  jobTitle    String? // "Marketing Manager", "Software Engineer"
  jobRole     String? @default("OTHER") // EXECUTIVE, MANAGER, IC, FREELANCER, STUDENT, OTHER
  department  String? // "Engineering", "Sales", "HR"
  industry    String? // "Technology", "Healthcare", "Finance"
  companySize String? @default("SMB") // SOLO, STARTUP, SMB, ENTERPRISE

  // Personalization - Communication Style
  communicationStyle String? @default("CASUAL") // FORMAL, CASUAL, TECHNICAL, CREATIVE
  responseLength     String? @default("MODERATE") // BRIEF, MODERATE, DETAILED

  // Personalization - Work Patterns
  workingHoursStart String?  @default("09:00")
  workingHoursEnd   String?  @default("18:00")
  workingDays       String[] @default(["MON", "TUE", "WED", "THU", "FRI"])

  // Personalization - AI Behavior
  proactivityLevel      String? @default("MEDIUM") // LOW, MEDIUM, HIGH
  notificationFrequency String? @default("DIGEST") // IMMEDIATE, DIGEST, MINIMAL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_preferences")
}

model DashboardPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Active layout configuration
  // Stores array of { i: string, x: number, y: number, w: number, h: number }
  layout Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboard_preferences")
}

// ============================================
// MFA Models - TOTP, Backup Codes, Trusted Devices
// ============================================

/// TOTP secrets for authenticator apps (Google Authenticator, Authy, etc.)
model MfaSecret {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // TOTP secret (encrypted with AES-256-GCM)
  secret       String // Encrypted Base32 secret
  encryptionIv String // IV for decryption

  // Status
  isEnabled  Boolean   @default(false) // Only true after first successful verification
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("mfa_secrets")
}

/// Backup/recovery codes for MFA emergency access
model MfaBackupCode {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Code storage (hashed with HMAC-SHA256)
  codeHash String // HMAC-SHA256 hash of the code

  // Status
  isUsed Boolean   @default(false)
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isUsed])
  @@map("mfa_backup_codes")
}

/// Trusted devices for "Keep me signed in" feature
model TrustedDevice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Device identification
  deviceToken String  @unique // UUID token stored in cookie
  deviceName  String? // "Chrome on Windows", "Safari on iPhone"
  deviceHash  String // Hash of user-agent + IP for validation

  // Location info (optional)
  ipAddress String?
  location  String? // "Rome, Italy"

  // Expiration
  expiresAt  DateTime // 30 days from creation
  lastUsedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([deviceToken])
  @@index([expiresAt])
  @@map("trusted_devices")
}

/// WebAuthn/Passkey credentials for passwordless authentication
/// Supports Face ID, Touch ID, Windows Hello, and security keys (YubiKey)
model WebAuthnCredential {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Credential data (W3C WebAuthn Level 3 spec)
  credentialId        String @unique // Base64URL encoded credential ID
  credentialPublicKey String // Base64URL encoded public key (COSE format)
  counter             Int    @default(0) // Signature counter for replay attack protection

  // Device type
  credentialDeviceType String  @default("singleDevice") // "singleDevice" | "multiDevice" (synced passkey)
  credentialBackedUp   Boolean @default(false) // True if passkey is synced across devices

  // Transports for optimizing re-authentication
  transports String[] @default([]) // "usb" | "nfc" | "ble" | "internal" | "hybrid"

  // Authenticator info
  aaguid     String? // Authenticator Attestation GUID (identifies authenticator model)
  deviceName String? // User-friendly name: "MacBook Pro Touch ID", "iPhone 15 Face ID"

  // Usage tracking
  lastUsedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("webauthn_credentials")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, token])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userEmail String
  token     String   @unique
  tenantId  String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model ProviderConfig {
  id                       String                @id @default(cuid())
  tenantId                 String
  userId                   String?
  providerType             String
  email                    String
  displayName              String?
  scope                    String? // Purpose/category: WORK, PERSONAL, LEGAL, INFO, etc.
  supportsEmail            Boolean               @default(true)
  supportsCalendar         Boolean               @default(false)
  supportsContacts         Boolean               @default(false)
  accessToken              String?
  refreshToken             String?
  tokenEncryptionIv        String?
  tokenExpiresAt           DateTime?
  imapHost                 String?
  imapPort                 Int?
  imapUsername             String?
  imapPassword             String?
  imapEncryptionIv         String?
  imapUseTls               Boolean               @default(true)
  smtpHost                 String?
  smtpPort                 Int?
  smtpUsername             String?
  smtpPassword             String?
  smtpEncryptionIv         String?
  smtpUseTls               Boolean               @default(true)
  caldavUrl                String?
  caldavUsername           String?
  caldavPassword           String?
  caldavEncryptionIv       String?
  carddavUrl               String?
  carddavUsername          String?
  carddavPassword          String?
  carddavEncryptionIv      String?
  metadata                 Json?
  isDefault                Boolean               @default(false)
  isActive                 Boolean               @default(true)
  lastSyncedAt             DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  avgActivityRate          Float?                @default(0.0)
  syncPriority             Int?                  @default(3)
  nextSyncAt               DateTime?
  emailsReceivedLast24h    Int?                  @default(0)
  errorStreak              Int?                  @default(0)
  lastActivityCheck        DateTime?
  refreshTokenEncryptionIv String?
  calendarEvents           CalendarEvent[]
  calendarSyncStates       CalendarSyncState[]
  providerContacts         ProviderContact[]     @relation("ProviderContactToProvider")
  emails                   Email[]
  folders                  Folder[]
  scheduledEmails          ScheduledEmail[]
  tenant                   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookSubscriptions     WebhookSubscription[]

  @@unique([tenantId, email, providerType])
  @@index([tenantId, isDefault])
  @@index([userId])
  @@index([nextSyncAt, isActive])
  @@index([syncPriority, nextSyncAt])
  @@map("provider_configs")
}

model Email {
  id                   String   @id @default(cuid())
  tenantId             String
  providerId           String
  externalId           String
  threadId             String?
  messageId            String?
  inReplyTo            String?
  references           String?
  from                 String
  to                   String[]
  cc                   String[] @default([])
  bcc                  String[] @default([])
  replyTo              String?
  subject              String
  bodyText             String?
  bodyHtml             String?
  snippet              String?
  folder               String   @default("INBOX")
  labels               String[] @default([])
  isRead               Boolean  @default(false)
  isStarred            Boolean  @default(false)
  isFlagged            Boolean  @default(false)
  isDraft              Boolean  @default(false)
  isDeleted            Boolean  @default(false)
  isArchived           Boolean  @default(false)
  sentAt               DateTime
  receivedAt           DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  size                 Int?
  headers              Json?
  metadata             Json?
  crossProviderLinkId  String?
  // Calendar invitation fields
  hasCalendarInvite    Boolean  @default(false)
  calendarInviteData   Json? // ParsedCalendarInvite JSON
  calendarInviteStatus String? // pending | accepted | declined | tentative
  calendarEventId      String? // Link to created CalendarEvent

  // RACE CONDITION FIX RC-2: Optimistic locking version field
  // Incremented on each update to detect concurrent modifications
  // User mutations (mark read, star, move) increment version
  // Sync operations check version before overwriting user changes
  version Int @default(1)

  // RACE CONDITION FIX RC-2: Track last user modification
  // Sync skips overwriting fields if userModifiedAt > lastSyncedAt
  userModifiedAt DateTime?

  attachments       EmailAttachment[]
  emailLabels       EmailLabel[]
  crossProviderLink EmailCrossProviderLink? @relation(fields: [crossProviderLinkId], references: [id])
  provider          ProviderConfig          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  followUp          EmailFollowUp?
  embeddings        Embedding[]

  // AI Refactor v2.0 relations
  analysis    EmailAnalysis?
  actionQueue ActionQueue[]

  @@unique([providerId, externalId, folder]) // UIDs are unique per-folder, not globally
  @@unique([tenantId, messageId, folder]) // Allow same messageId in different folders
  @@index([tenantId, folder, receivedAt])
  @@index([tenantId, isRead])
  @@index([tenantId, threadId])
  @@index([sentAt])
  @@index([crossProviderLinkId])
  @@index([tenantId, hasCalendarInvite])
  // P2 Optimization: Additional composite indexes for common query patterns
  @@index([tenantId, providerId, folder, receivedAt]) // Provider-specific folder listing
  @@index([tenantId, isStarred, receivedAt]) // Starred emails listing
  @@index([tenantId, providerId, isDeleted]) // Provider deletion queries
  // HIGH-4 FIX (2025-01-05): Composite index for count queries (unread count per folder)
  @@index([providerId, folder, isRead])
  // Search optimization indexes (avoid embedding costs)
  @@index([tenantId, from]) // "email from Mario"
  @@index([tenantId, isFlagged]) // Flagged email listing
  // GIN trigram indexes for partial text search (LIKE '%keyword%')
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin) // Subject search
  @@index([from(ops: raw("gin_trgm_ops"))], type: Gin) // Sender search with partial match
  @@map("emails")
}

model ScheduledEmail {
  id           String         @id @default(cuid())
  tenantId     String
  providerId   String
  to           String[]
  cc           String[]       @default([])
  bcc          String[]       @default([])
  subject      String
  bodyHtml     String
  bodyText     String
  inReplyTo    String?
  references   String?
  attachments  Json? // Store attachment data as JSON
  scheduledAt  DateTime
  status       String         @default("pending") // pending, processing, sent, failed
  errorMessage String?
  retryCount   Int            @default(0)
  sentAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  provider     ProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, scheduledAt])
  @@index([scheduledAt, status])
  @@map("scheduled_emails")
}

model Folder {
  id           String         @id @default(cuid())
  tenantId     String
  providerId   String
  name         String
  path         String
  externalId   String?
  delimiter    String         @default("/")
  parentId     String?
  level        Int            @default(0)
  isSelectable Boolean        @default(true)
  specialUse   String?
  // Explicit system folder flag - set during sync based on provider detection
  // TRUE = system folder (INBOX, SENT, etc.) - cannot edit/delete
  // FALSE = user folder - can edit/delete
  isSystem     Boolean        @default(false)
  attributes   String[]       @default([])
  totalCount   Int            @default(0)
  unreadCount  Int            @default(0)
  recentCount  Int            @default(0)
  unseenCount  Int            @default(0)
  uidValidity  String?
  uidNext      Int?           @default(0)
  syncToken    String?
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  parent       Folder?        @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[]       @relation("FolderHierarchy")
  provider     ProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([providerId, path])
  @@index([providerId, externalId])
  @@index([tenantId, providerId])
  @@index([tenantId, specialUse])
  @@index([tenantId, isSystem])
  @@index([providerId, parentId])
  @@index([lastSyncedAt])
  @@map("folders")
}

enum LabelType {
  SYSTEM
  USER
}

model UserLabel {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  type        LabelType    @default(USER)
  color       Json?
  icon        String?
  parentId    String?
  level       Int          @default(0)
  orderIndex  Int          @default(0)
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  parent      UserLabel?   @relation("LabelHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    UserLabel[]  @relation("LabelHierarchy")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emailLabels EmailLabel[]

  @@unique([tenantId, slug])
  @@index([tenantId, type])
  @@index([tenantId, parentId])
  @@index([tenantId, orderIndex])
  @@map("user_labels")
}

model EmailLabel {
  id        String    @id @default(cuid())
  emailId   String
  labelId   String
  createdAt DateTime  @default(now())
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)
  label     UserLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([emailId, labelId])
  @@index([emailId])
  @@index([labelId])
  @@index([createdAt])
  @@map("email_labels")
}

model EmailAttachment {
  id          String   @id @default(cuid())
  emailId     String
  filename    String
  mimeType    String
  size        Int
  contentId   String?
  storageType String   @default("local")
  storagePath String?
  contentHash String?
  isInline    Boolean  @default(false)
  createdAt   DateTime @default(now())
  email       Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@map("email_attachments")
}

model EmailCrossProviderLink {
  id               String    @id @default(cuid())
  tenantId         String
  contentHash      String
  conflictStrategy String    @default("LAST_WRITE_WINS")
  mergedIsRead     Boolean   @default(false)
  mergedIsStarred  Boolean   @default(false)
  mergedFolder     String    @default("INBOX")
  mergedLabels     String[]  @default([])
  providerCount    Int       @default(0)
  lastSyncedAt     DateTime  @default(now())
  lastConflictAt   DateTime?
  lastConflict     Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  emails           Email[]

  @@unique([tenantId, contentHash])
  @@index([tenantId, lastSyncedAt])
  @@index([contentHash])
  @@map("email_cross_provider_links")
}

model Embedding {
  id             String                      @id @default(cuid())
  tenantId       String
  documentName   String?
  content        String
  /// Mistral-embed produces 1024-dimensional vectors
  vector         Unsupported("vector(1024)")?
  embeddingModel String                      @default("mistral-embed")
  metadata       Json?

  // Hard Links (Polymorphic-style but with FKs)
  emailId String?
  email   Email?  @relation(fields: [emailId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([emailId])
  // HNSW index created in migration: 20250106_hnsw_vector_index
  @@map("embeddings")
}

model CalendarEvent {
  id               String                    @id @default(cuid())
  tenantId         String
  providerId       String
  externalId       String
  calendarId       String?
  iCalUID          String?
  title            String
  description      String?
  location         String?
  organizer        String?
  attendees        Json?
  startTime        DateTime
  endTime          DateTime
  isAllDay         Boolean                   @default(false)
  timeZone         String                    @default("UTC")
  recurrence       String[]                  @default([])
  recurringEventId String?
  status           String                    @default("confirmed")
  visibility       String                    @default("default")
  isDeleted        Boolean                   @default(false)
  isCancelled      Boolean                   @default(false)
  reminders        Json?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  metadata         Json?
  htmlLink         String?
  lastSyncedAt     DateTime                  @default(now())
  syncVersion      Int                       @default(1)
  calendarName     String?
  provider         ProviderConfig            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attachments      CalendarEventAttachment[]

  @@unique([providerId, externalId])
  @@index([tenantId, startTime])
  @@index([tenantId, calendarId, startTime])
  @@index([tenantId, providerId, startTime])
  @@index([iCalUID])
  // Search optimization (avoid embedding costs)
  @@index([tenantId, title]) // "call with Mario"
  // GIN trigram index for partial title search
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("calendar_events")
}

model CalendarEventAttachment {
  id            String        @id @default(cuid())
  eventId       String
  filename      String
  mimeType      String
  size          Int
  storageType   String        @default("s3")
  storagePath   String?
  fileUrl       String?
  fileId        String?
  iconLink      String?
  isGoogleDrive Boolean       @default(false)
  isOneDrive    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  event         CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("calendar_event_attachments")
}

/// CalendarPreference - User preferences for calendars (color, visibility)
/// Stores UI preferences that persist across sessions
model CalendarPreference {
  id         String @id @default(cuid())
  tenantId   String
  providerId String
  calendarId String // External calendar ID (Google/Microsoft/custom)

  // Preferences
  color       String? // Hex color code (e.g., "#FF5722")
  isVisible   Boolean @default(true) // Show/hide in calendar view
  displayName String? // Custom display name (overrides provider name)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, providerId, calendarId])
  @@index([tenantId])
  @@index([providerId])
  @@map("calendar_preferences")
}

/// CalendarSyncState - Per-calendar sync tokens for incremental sync
/// Stores Google syncToken and Microsoft deltaLink for efficient calendar syncing
/// Reduces API calls by ~95% after initial full sync
model CalendarSyncState {
  id           String  @id @default(cuid())
  providerId   String
  calendarId   String // External calendar ID (Google/Microsoft)
  calendarName String? // Human-readable name for debugging

  // Sync tokens (provider-specific)
  syncToken String? // Google Calendar syncToken
  deltaLink String? // Microsoft Graph deltaLink (full URL)

  // Sync metadata
  lastFullSyncAt    DateTime? // When we last did a full sync
  lastIncrementalAt DateTime? // When we last did an incremental sync
  fullSyncRequired  Boolean   @default(true) // Force full sync on next run

  // Error tracking for resilience
  consecutiveErrors Int       @default(0)
  lastError         String?
  lastErrorAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider ProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, calendarId])
  @@index([providerId])
  @@index([fullSyncRequired])
  @@map("calendar_sync_states")
}

// Unified Contact - Single source of truth for each person
// Can be enriched by user, aggregates data from multiple providers
model Contact {
  id       String @id @default(cuid())
  tenantId String

  // User-enriched fields (can override provider data)
  displayName String?
  firstName   String?
  lastName    String?
  middleName  String?
  nickname    String?
  prefix      String?
  suffix      String?

  // Aggregated data (merged from all provider contacts)
  emails       Json? // Array of all emails from all providers
  phoneNumbers Json? // Array of all phone numbers
  addresses    Json? // Array of all addresses

  // Work info
  company    String?
  jobTitle   String?
  department String?

  // Personal info
  birthday    DateTime?
  anniversary DateTime?

  // Social
  websites       Json?
  socialProfiles Json?

  // User customization
  notes     String? // User's personal notes
  tags      String[] @default([]) // User-defined tags
  photoUrl  String?
  photoEtag String?

  // Flags
  isDeleted  Boolean @default(false)
  isStarred  Boolean @default(false)
  isFavorite Boolean @default(false)

  // === P1.7 CRM Intelligence Fields ===
  lastInteractedAt    DateTime? // Last email sent/received with this contact
  totalInteractions   Int       @default(0) // Total email count
  sentCount           Int       @default(0) // Emails sent to contact
  receivedCount       Int       @default(0) // Emails received from contact
  relationshipScore   Float? // 0-100 computed score
  reconnectRemindedAt DateTime? // Last reconnect reminder sent

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Metadata
  metadata Json?

  // Relations
  providerContacts    ProviderContact[] // Links to provider sources
  contactInteractions ContactInteraction[] // P1.7: Interaction history
  tenant              Tenant               @relation("ContactToTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  // AI Refactor v2.0 CRM
  deals Deal[]

  @@index([tenantId, displayName])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, company])
  // Composite index for OR search across multiple fields (perf optimization)
  @@index([tenantId, displayName, firstName, lastName, company])
  // P1.7 CRM Intelligence indexes
  @@index([tenantId, lastInteractedAt])
  @@index([tenantId, relationshipScore])
  // GIN trigram index for partial name search (avoid embedding costs)
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin) // "find Mario"
  @@map("unified_contacts")
}

// Provider Contact - Reference to external provider contact
// Stores raw data as-is from provider (Google, Microsoft, etc)
model ProviderContact {
  id           String  @id @default(cuid())
  contactId    String // Foreign key to unified Contact
  tenantId     String
  providerId   String
  externalId   String // Provider's contact ID
  contactGroup String?

  // Raw provider data (as-is from provider API)
  rawData        Json? // Full provider response for reference
  firstName      String?
  lastName       String?
  middleName     String?
  displayName    String?
  nickname       String?
  prefix         String?
  suffix         String?
  emails         Json?
  phoneNumbers   Json?
  addresses      Json?
  company        String?
  jobTitle       String?
  department     String?
  birthday       DateTime?
  anniversary    DateTime?
  websites       Json?
  socialProfiles Json?
  notes          String?
  photoUrl       String?
  photoEtag      String?

  // Provider sync metadata
  vCardVersion String?  @default("4.0")
  lastSyncedAt DateTime @default(now())
  syncVersion  Int      @default(1)
  eTag         String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Metadata
  metadata Json?

  // Relations
  contact  Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  provider ProviderConfig @relation("ProviderContactToProvider", fields: [providerId], references: [id], onDelete: Cascade)
  tenant   Tenant         @relation("ProviderContactToTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalId])
  @@index([contactId])
  @@index([tenantId])
  @@index([tenantId, displayName])
  @@index([contactGroup])
  @@map("provider_contacts")
}

