// AI LONG-TERM MEMORY (Restored 2025-01-07)
// Simplified from original mem0 implementation
// ============================================

/// User AI memories - facts, preferences, patterns learned from conversations
model AIMemory {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  // Memory content
  content    String     @db.Text
  memoryType MemoryType @default(FACT)
  source     String?    // EXPLICIT (user added), INFERRED (AI extracted), CONVERSATION

  // Importance and usage tracking
  confidence Float    @default(0.5) // 0-1 confidence score
  usageCount Int      @default(0)   // How often this memory was used
  lastUsedAt DateTime?

  // Categorization
  category String? // User-defined or auto-detected category
  tags     String? // Comma-separated tags

  // Metadata
  metadata Json? // Additional structured data

  // Lifecycle
  expiresAt DateTime? // Optional expiration
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // History tracking
  history AIMemoryHistory[]

  @@index([tenantId, userId])
  @@index([tenantId, userId, memoryType])
  @@index([tenantId, userId, category])
  @@map("ai_memories")
}

/// Memory type categories
enum MemoryType {
  PREFERENCE    // User preferences (e.g., "prefers brief emails")
  FACT          // Facts about user (e.g., "works at Acme Corp")
  PATTERN       // Behavioral patterns (e.g., "usually replies in morning")
  INTERACTION   // Important past interactions
  CONTACT_NOTE  // Notes about contacts
}

/// Change history for memories (audit trail)
model AIMemoryHistory {
  id        String   @id @default(cuid())
  memoryId  String
  action    String   // CREATE, UPDATE, DELETE
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  changedBy String?  // Who/what made the change
  createdAt DateTime @default(now())

  memory AIMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@map("ai_memory_history")
}

/// Tracks emails that need follow-up
model EmailFollowUp {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  emailId  String @unique // Reference to email.id

  // Follow-up details
  status  FollowUpStatus @default(PENDING)
  reason  String? // Why follow-up is needed
  dueDate DateTime // When to remind

  // Reminder tracking
  remindCount    Int       @default(0)
  lastRemindedAt DateTime?

  // Resolution
  resolvedAt DateTime?
  resolvedBy String? // "REPLY_RECEIVED", "MANUAL", "AUTO_EXPIRED"

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, userId, status])
  @@index([dueDate])
  @@map("email_follow_ups")
}

enum FollowUpStatus {
  PENDING
  REMINDED
  RESOLVED
  EXPIRED
}

/// Tracks contact interaction history for relationship intelligence (P1.7)
model ContactInteraction {
  id        String @id @default(cuid())
  tenantId  String
  contactId String // Reference to unified_contacts.id
  userId    String // User who had the interaction

  // Interaction details
  type      ContactInteractionType
  date      DateTime
  summary   String?                @db.Text
  sentiment String? // POSITIVE, NEUTRAL, NEGATIVE

  // Source tracking
  sourceType String? // EMAIL, CALENDAR, MANUAL
  sourceId   String? // Reference to source record
  emailId    String? @unique // Direct link to email (prevents duplicates)

  // Denormalized for faster queries
  contactEmail String? // Email address used in interaction
  contactName  String? // Display name at time of interaction

  createdAt DateTime @default(now())

  // Relations
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId])
  @@index([tenantId, contactId, date])
  @@index([tenantId, userId])
  @@index([tenantId, userId, date])
  @@index([emailId])
  @@map("contact_interactions")
}

enum ContactInteractionType {
  EMAIL_SENT
  EMAIL_RECEIVED
  MEETING
  CALL
  NOTE
}

