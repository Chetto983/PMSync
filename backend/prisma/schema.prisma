enum AiRunStatus {
  SUCCESS
  FAILED
  TIMEOUT
}

model AiRunLedger {
  id               String      @id @default(cuid())
  tenantId         String
  userId           String
  runType          String      // 'chat', 'briefing', 'follow-up-detection', 'draft-generation'
  model            String      // 'mistral-large-latest', 'mistral-small-latest', etc.
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  totalTokens      Int         @default(0)
