generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  description          String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  auditLogs            AuditLog[]
  calendarEvents       CalendarEvent[]
  contacts             Contact[]             @relation("ContactToTenant")
  providerContacts     ProviderContact[]     @relation("ProviderContactToTenant")
  emails               Email[]
  embeddings           Embedding[]
  folders              Folder[]
  providerConfigs      ProviderConfig[]
  scheduledEmails      ScheduledEmail[]
  users                User[]
  webhookSubscriptions WebhookSubscription[]
  userLabels           UserLabel[]

  @@map("tenants")
}

model User {
  id                    String                 @id @default(cuid())
  tenantId              String
  email                 String
  passwordHash          String
  firstName             String?
  lastName              String?
  role                  String                 @default("user")
  isActive              Boolean                @default(true)
  isMfaEnabled          Boolean                @default(true)
  lastLogin             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  auditLogs             AuditLog[]
  mfaSecret             MfaSecret?
  mfaBackupCodes        MfaBackupCode[]
  trustedDevices        TrustedDevice[]
  webauthnCredentials   WebAuthnCredential[]
  sessions              Session[]
  userPreferences       UserPreferences?
  writingStyleProfile   WritingStyleProfile?
  agentPendingActions   AgentPendingAction[]   @relation("AgentPendingActionsToUser")
  agentActionFeedback   AgentActionFeedback[]  @relation("AgentActionFeedbackToUser")
  userProfileEmbeddings UserProfileEmbedding[] @relation("UserProfileEmbeddingsToUser")
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model UserPreferences {
  id                          String  @id @default(cuid())
  userId                      String  @unique
  folderOrders                Json?
  sidebarSmartFiltersExpanded Boolean @default(true)
  sidebarLabelsExpanded       Boolean @default(true)
  theme                       String? @default("light")
  language                    String? @default("en")
  timezone                    String? @default("UTC")
  emailDensity                String? @default("comfortable")

  // AI Agent Preferences
  aiSmartRepliesEnabled  Boolean @default(true)
  aiSummarizationEnabled Boolean @default(true)
  aiSchedulingEnabled    Boolean @default(true)
  aiAutoApproveThreshold Float?  @default(0.9) // 0-1 confidence threshold for auto-approval

  // Personalization - Job/Role
  jobTitle    String? // "Marketing Manager", "Software Engineer"
  jobRole     String? @default("OTHER") // EXECUTIVE, MANAGER, IC, FREELANCER, STUDENT, OTHER
  department  String? // "Engineering", "Sales", "HR"
  industry    String? // "Technology", "Healthcare", "Finance"
  companySize String? @default("SMB") // SOLO, STARTUP, SMB, ENTERPRISE

  // Personalization - Communication Style
  communicationStyle String? @default("CASUAL") // FORMAL, CASUAL, TECHNICAL, CREATIVE
  responseLength     String? @default("MODERATE") // BRIEF, MODERATE, DETAILED

  // Personalization - Work Patterns
  workingHoursStart String?  @default("09:00")
  workingHoursEnd   String?  @default("18:00")
  workingDays       String[] @default(["MON", "TUE", "WED", "THU", "FRI"])

  // Personalization - AI Behavior
  proactivityLevel      String? @default("MEDIUM") // LOW, MEDIUM, HIGH
  notificationFrequency String? @default("DIGEST") // IMMEDIATE, DIGEST, MINIMAL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_preferences")
}

// ============================================
// MFA Models - TOTP, Backup Codes, Trusted Devices
// ============================================

/// TOTP secrets for authenticator apps (Google Authenticator, Authy, etc.)
model MfaSecret {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // TOTP secret (encrypted with AES-256-GCM)
  secret       String // Encrypted Base32 secret
  encryptionIv String // IV for decryption

  // Status
  isEnabled  Boolean   @default(false) // Only true after first successful verification
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("mfa_secrets")
}

/// Backup/recovery codes for MFA emergency access
model MfaBackupCode {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Code storage (hashed with HMAC-SHA256)
  codeHash String // HMAC-SHA256 hash of the code

  // Status
  isUsed Boolean   @default(false)
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isUsed])
  @@map("mfa_backup_codes")
}

/// Trusted devices for "Keep me signed in" feature
model TrustedDevice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Device identification
  deviceToken String  @unique // UUID token stored in cookie
  deviceName  String? // "Chrome on Windows", "Safari on iPhone"
  deviceHash  String // Hash of user-agent + IP for validation

  // Location info (optional)
  ipAddress String?
  location  String? // "Rome, Italy"

  // Expiration
  expiresAt  DateTime // 30 days from creation
  lastUsedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([deviceToken])
  @@index([expiresAt])
  @@map("trusted_devices")
}

/// WebAuthn/Passkey credentials for passwordless authentication
/// Supports Face ID, Touch ID, Windows Hello, and security keys (YubiKey)
model WebAuthnCredential {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Credential data (W3C WebAuthn Level 3 spec)
  credentialId        String @unique // Base64URL encoded credential ID
  credentialPublicKey String // Base64URL encoded public key (COSE format)
  counter             Int    @default(0) // Signature counter for replay attack protection

  // Device type
  credentialDeviceType  String  @default("singleDevice") // "singleDevice" | "multiDevice" (synced passkey)
  credentialBackedUp    Boolean @default(false) // True if passkey is synced across devices

  // Transports for optimizing re-authentication
  transports String[] @default([]) // "usb" | "nfc" | "ble" | "internal" | "hybrid"

  // Authenticator info
  aaguid     String? // Authenticator Attestation GUID (identifies authenticator model)
  deviceName String? // User-friendly name: "MacBook Pro Touch ID", "iPhone 15 Face ID"

  // Usage tracking
  lastUsedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("webauthn_credentials")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, token])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userEmail String
  token     String   @unique
  tenantId  String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model ProviderConfig {
  id                       String                @id @default(cuid())
  tenantId                 String
  userId                   String?
  providerType             String
  email                    String
  displayName              String?
  supportsEmail            Boolean               @default(true)
  supportsCalendar         Boolean               @default(false)
  supportsContacts         Boolean               @default(false)
  accessToken              String?
  refreshToken             String?
  tokenEncryptionIv        String?
  tokenExpiresAt           DateTime?
  imapHost                 String?
  imapPort                 Int?
  imapUsername             String?
  imapPassword             String?
  imapEncryptionIv         String?
  imapUseTls               Boolean               @default(true)
  smtpHost                 String?
  smtpPort                 Int?
  smtpUsername             String?
  smtpPassword             String?
  smtpEncryptionIv         String?
  smtpUseTls               Boolean               @default(true)
  caldavUrl                String?
  caldavUsername           String?
  caldavPassword           String?
  caldavEncryptionIv       String?
  carddavUrl               String?
  carddavUsername          String?
  carddavPassword          String?
  carddavEncryptionIv      String?
  metadata                 Json?
  isDefault                Boolean               @default(false)
  isActive                 Boolean               @default(true)
  lastSyncedAt             DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  avgActivityRate          Float?                @default(0.0)
  syncPriority             Int?                  @default(3)
  nextSyncAt               DateTime?
  emailsReceivedLast24h    Int?                  @default(0)
  errorStreak              Int?                  @default(0)
  lastActivityCheck        DateTime?
  refreshTokenEncryptionIv String?
  calendarEvents           CalendarEvent[]
  providerContacts         ProviderContact[]     @relation("ProviderContactToProvider")
  emails                   Email[]
  folders                  Folder[]
  scheduledEmails          ScheduledEmail[]
  tenant                   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookSubscriptions     WebhookSubscription[]

  @@unique([tenantId, email, providerType])
  @@index([tenantId, isDefault])
  @@index([userId])
  @@index([nextSyncAt, isActive])
  @@index([syncPriority, nextSyncAt])
  @@map("provider_configs")
}

model Email {
  id                   String                  @id @default(cuid())
  tenantId             String
  providerId           String
  externalId           String
  threadId             String?
  messageId            String?
  inReplyTo            String?
  references           String?
  from                 String
  to                   String[]
  cc                   String[]                @default([])
  bcc                  String[]                @default([])
  replyTo              String?
  subject              String
  bodyText             String?
  bodyHtml             String?
  snippet              String?
  folder               String                  @default("INBOX")
  labels               String[]                @default([])
  isRead               Boolean                 @default(false)
  isStarred            Boolean                 @default(false)
  isFlagged            Boolean                 @default(false)
  isDraft              Boolean                 @default(false)
  isDeleted            Boolean                 @default(false)
  isArchived           Boolean                 @default(false)
  sentAt               DateTime
  receivedAt           DateTime
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  size                 Int?
  headers              Json?
  metadata             Json?
  crossProviderLinkId  String?
  // Calendar invitation fields
  hasCalendarInvite    Boolean                 @default(false)
  calendarInviteData   Json? // ParsedCalendarInvite JSON
  calendarInviteStatus String? // pending | accepted | declined | tentative
  calendarEventId      String? // Link to created CalendarEvent
  attachments          EmailAttachment[]
  emailLabels          EmailLabel[]
  crossProviderLink    EmailCrossProviderLink? @relation(fields: [crossProviderLinkId], references: [id])
  provider             ProviderConfig          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalId, folder])  // UIDs are unique per-folder, not globally
  @@unique([tenantId, messageId, folder])  // Allow same messageId in different folders
  @@index([tenantId, folder, receivedAt])
  @@index([tenantId, isRead])
  @@index([tenantId, threadId])
  @@index([sentAt])
  @@index([crossProviderLinkId])
  @@index([tenantId, hasCalendarInvite])
  @@map("emails")
}

model ScheduledEmail {
  id           String         @id @default(cuid())
  tenantId     String
  providerId   String
  to           String[]
  cc           String[]       @default([])
  bcc          String[]       @default([])
  subject      String
  bodyHtml     String
  bodyText     String
  inReplyTo    String?
  references   String?
  attachments  Json? // Store attachment data as JSON
  scheduledAt  DateTime
  status       String         @default("pending") // pending, processing, sent, failed
  errorMessage String?
  retryCount   Int            @default(0)
  sentAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  provider     ProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, scheduledAt])
  @@index([scheduledAt, status])
  @@map("scheduled_emails")
}

model Folder {
  id           String         @id @default(cuid())
  tenantId     String
  providerId   String
  name         String
  path         String
  externalId   String?
  delimiter    String         @default("/")
  parentId     String?
  level        Int            @default(0)
  isSelectable Boolean        @default(true)
  specialUse   String?
  attributes   String[]       @default([])
  totalCount   Int            @default(0)
  unreadCount  Int            @default(0)
  recentCount  Int            @default(0)
  unseenCount  Int            @default(0)
  uidValidity  String?
  uidNext      Int?           @default(0)
  syncToken    String?
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  parent       Folder?        @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[]       @relation("FolderHierarchy")
  provider     ProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([providerId, path])
  @@index([providerId, externalId])
  @@index([tenantId, providerId])
  @@index([tenantId, specialUse])
  @@index([providerId, parentId])
  @@index([lastSyncedAt])
  @@map("folders")
}

enum LabelType {
  SYSTEM
  USER
}

model UserLabel {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  type        LabelType    @default(USER)
  color       Json?
  icon        String?
  parentId    String?
  level       Int          @default(0)
  orderIndex  Int          @default(0)
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  parent      UserLabel?   @relation("LabelHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    UserLabel[]  @relation("LabelHierarchy")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emailLabels EmailLabel[]

  @@unique([tenantId, slug])
  @@index([tenantId, type])
  @@index([tenantId, parentId])
  @@index([tenantId, orderIndex])
  @@map("user_labels")
}

model EmailLabel {
  id        String    @id @default(cuid())
  emailId   String
  labelId   String
  createdAt DateTime  @default(now())
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)
  label     UserLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([emailId, labelId])
  @@index([emailId])
  @@index([labelId])
  @@index([createdAt])
  @@map("email_labels")
}

model EmailAttachment {
  id          String   @id @default(cuid())
  emailId     String
  filename    String
  mimeType    String
  size        Int
  contentId   String?
  storageType String   @default("local")
  storagePath String?
  contentHash String?
  isInline    Boolean  @default(false)
  createdAt   DateTime @default(now())
  email       Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@map("email_attachments")
}

model EmailCrossProviderLink {
  id               String    @id @default(cuid())
  tenantId         String
  contentHash      String
  conflictStrategy String    @default("LAST_WRITE_WINS")
  mergedIsRead     Boolean   @default(false)
  mergedIsStarred  Boolean   @default(false)
  mergedFolder     String    @default("INBOX")
  mergedLabels     String[]  @default([])
  providerCount    Int       @default(0)
  lastSyncedAt     DateTime  @default(now())
  lastConflictAt   DateTime?
  lastConflict     Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  emails           Email[]

  @@unique([tenantId, contentHash])
  @@index([tenantId, lastSyncedAt])
  @@index([contentHash])
  @@map("email_cross_provider_links")
}

model Embedding {
  id             String                 @id @default(cuid())
  tenantId       String
  documentName   String?
  content        String
  vector         Unsupported("vector")?
  embeddingModel String                 @default("mistral-embed")
  metadata       Json?
  createdAt      DateTime               @default(now())
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("embeddings")
}

model CalendarEvent {
  id               String                    @id @default(cuid())
  tenantId         String
  providerId       String
  externalId       String
  calendarId       String?
  iCalUID          String?
  title            String
  description      String?
  location         String?
  organizer        String?
  attendees        Json?
  startTime        DateTime
  endTime          DateTime
  isAllDay         Boolean                   @default(false)
  timeZone         String                    @default("UTC")
  recurrence       String[]                  @default([])
  recurringEventId String?
  status           String                    @default("confirmed")
  visibility       String                    @default("default")
  isDeleted        Boolean                   @default(false)
  isCancelled      Boolean                   @default(false)
  reminders        Json?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  metadata         Json?
  htmlLink         String?
  lastSyncedAt     DateTime                  @default(now())
  syncVersion      Int                       @default(1)
  calendarName     String?
  provider         ProviderConfig            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attachments      CalendarEventAttachment[]

  @@unique([providerId, externalId])
  @@index([tenantId, startTime])
  @@index([tenantId, calendarId, startTime])
  @@index([tenantId, providerId, startTime])
  @@index([iCalUID])
  @@map("calendar_events")
}

model CalendarEventAttachment {
  id            String        @id @default(cuid())
  eventId       String
  filename      String
  mimeType      String
  size          Int
  storageType   String        @default("s3")
  storagePath   String?
  fileUrl       String?
  fileId        String?
  iconLink      String?
  isGoogleDrive Boolean       @default(false)
  isOneDrive    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  event         CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("calendar_event_attachments")
}

// Unified Contact - Single source of truth for each person
// Can be enriched by user, aggregates data from multiple providers
model Contact {
  id       String @id @default(cuid())
  tenantId String

  // User-enriched fields (can override provider data)
  displayName String?
  firstName   String?
  lastName    String?
  middleName  String?
  nickname    String?
  prefix      String?
  suffix      String?

  // Aggregated data (merged from all provider contacts)
  emails       Json? // Array of all emails from all providers
  phoneNumbers Json? // Array of all phone numbers
  addresses    Json? // Array of all addresses

  // Work info
  company    String?
  jobTitle   String?
  department String?

  // Personal info
  birthday    DateTime?
  anniversary DateTime?

  // Social
  websites       Json?
  socialProfiles Json?

  // User customization
  notes     String? // User's personal notes
  tags      String[] @default([]) // User-defined tags
  photoUrl  String?
  photoEtag String?

  // Flags
  isDeleted  Boolean @default(false)
  isStarred  Boolean @default(false)
  isFavorite Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Metadata
  metadata Json?

  // Relations
  providerContacts ProviderContact[] // Links to provider sources
  tenant           Tenant            @relation("ContactToTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, displayName])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, company])
  @@map("unified_contacts")
}

// Provider Contact - Reference to external provider contact
// Stores raw data as-is from provider (Google, Microsoft, etc)
model ProviderContact {
  id           String  @id @default(cuid())
  contactId    String // Foreign key to unified Contact
  tenantId     String
  providerId   String
  externalId   String // Provider's contact ID
  contactGroup String?

  // Raw provider data (as-is from provider API)
  rawData        Json? // Full provider response for reference
  firstName      String?
  lastName       String?
  middleName     String?
  displayName    String?
  nickname       String?
  prefix         String?
  suffix         String?
  emails         Json?
  phoneNumbers   Json?
  addresses      Json?
  company        String?
  jobTitle       String?
  department     String?
  birthday       DateTime?
  anniversary    DateTime?
  websites       Json?
  socialProfiles Json?
  notes          String?
  photoUrl       String?
  photoEtag      String?

  // Provider sync metadata
  vCardVersion String?  @default("4.0")
  lastSyncedAt DateTime @default(now())
  syncVersion  Int      @default(1)
  eTag         String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Metadata
  metadata Json?

  // Relations
  contact  Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  provider ProviderConfig @relation("ProviderContactToProvider", fields: [providerId], references: [id], onDelete: Cascade)
  tenant   Tenant         @relation("ProviderContactToTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalId])
  @@index([contactId])
  @@index([tenantId])
  @@index([tenantId, displayName])
  @@index([contactGroup])
  @@map("provider_contacts")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String
  changes   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model JobQueue {
  id          String    @id @default(cuid())
  tenantId    String
  jobId       String
  jobType     String
  status      String    @default("pending")
  data        Json
  result      Json?
  error       String?
  retries     Int       @default(0)
  maxRetries  Int       @default(3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([tenantId, status])
  @@index([createdAt])
  @@map("job_queue")
}

model WebhookSubscription {
  id                 String         @id @default(cuid())
  providerId         String
  providerType       String
  subscriptionId     String
  webhookUrl         String?
  resourcePath       String         @default("generic")
  isActive           Boolean        @default(true)
  expiresAt          DateTime
  lastRenewedAt      DateTime       @default(now())
  metadata           Json?
  lastNotificationAt DateTime?
  notificationCount  Int            @default(0)
  errorCount         Int            @default(0)
  lastError          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  tenantId           String
  provider           ProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([providerId, resourcePath])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([providerId, isActive])
  @@index([expiresAt])
  @@index([providerType])
  @@index([subscriptionId])
  @@map("webhook_subscriptions")
}

model HealthCheck {
  id            String   @id @default(cuid())
  service       String   @unique
  status        String   @default("up")
  lastCheckedAt DateTime @default(now())
  responseTime  Int?
  error         String?

  @@map("health_checks")
}

// ============================================
// Multi-Agent System Models
// ============================================

// Pending actions proposed by agents awaiting HITL approval
model AgentPendingAction {
  id                 String  @id @default(cuid())
  sessionId          String? // ChatSession reference (optional)
  tenantId           String
  userId             String
  agentName          String // Which agent proposed (EmailAgent, CalendarAgent, etc)
  actionType         String // SEND_EMAIL, CREATE_EVENT, MERGE_CONTACTS, etc
  payload            Json // Action-specific data
  confidence         Float // 0.0 - 1.0 original confidence
  adjustedConfidence Float? // After learning boost applied
  severity           String  @default("MEDIUM") // LOW, MEDIUM, HIGH
  status             String  @default("PENDING") // PENDING, APPROVED, EXECUTED, REJECTED, EXPIRED
  reasoningSteps     String? // LLM reasoning explanation

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime? // Auto-expire if not actioned
  approvedAt      DateTime?
  approvedBy      String? // User who approved
  executedAt      DateTime?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?

  // Relations
  feedback AgentActionFeedback[]
  user     User                  @relation("AgentPendingActionsToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, userId, status])
  @@index([sessionId])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("agent_pending_actions")
}

// Feedback recorded for agent actions (for learning loop)
model AgentActionFeedback {
  id                 String   @id @default(cuid())
  actionId           String
  tenantId           String
  userId             String
  agentName          String
  actionType         String
  wasApproved        Boolean
  wasExecuted        Boolean
  wasSuccessful      Boolean?
  originalConfidence Float
  adjustedConfidence Float?
  userFeedback       String? // Optional text feedback
  userRating         Int? // 1-5 stars (optional)
  executionTimeMs    Int?
  errorMessage       String?
  contextSnapshot    Json? // Snapshot of context for analysis
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  action AgentPendingAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user   User               @relation("AgentActionFeedbackToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, agentName])
  @@index([userId, actionType])
  @@index([wasApproved])
  @@index([createdAt])
  @@index([actionId])
  @@map("agent_action_feedback")
}

// Learning profiles for confidence adjustment over time
model AgentLearningProfile {
  id                    String    @id @default(cuid())
  tenantId              String
  userId                String? // NULL = tenant-wide profile
  agentName             String
  actionType            String
  totalAttempts         Int       @default(0)
  approvedCount         Int       @default(0)
  rejectedCount         Int       @default(0)
  autoExecutedCount     Int       @default(0)
  avgOriginalConfidence Float     @default(0.5)
  avgAdjustedConfidence Float     @default(0.5)
  successRate           Float     @default(0.0)
  lastLearningAt        DateTime?
  confidenceBoost       Float     @default(0.0) // -0.3 to +0.3 adjustment
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([tenantId, userId, agentName, actionType])
  @@index([tenantId])
  @@index([agentName, actionType])
  @@map("agent_learning_profiles")
}

// ============================================
// Prompt Registry - Versioned prompt templates
// ============================================

model PromptTemplate {
  id       String  @id @default(cuid())
  tenantId String? // NULL = system default template
  name     String // e.g., "router.classify", "email.compose", "calendar.schedule"
  version  Int     @default(1)
  locale   String  @default("en") // en, it, es, fr, de, pt
  bucket   String? // A/B test bucket identifier

  // Prompt content
  body      String @db.Text // The actual prompt template with {variables}
  variables Json? // Expected variables schema: { "userMessage": "string", "history": "array" }

  // Configuration
  metadata Json? // { "temperature": 0.3, "maxTokens": 500, "model": "mistral-small-latest" }

  // Status
  isActive  Boolean @default(true)
  isDefault Boolean @default(false) // Default for this name+locale combination

  // Audit
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name, version, locale, bucket])
  @@index([tenantId, name, isActive])
  @@index([name, locale, isActive])
  @@map("prompt_templates")
}

// ============================================
// LLM Telemetry - Track AI usage and costs
// ============================================

model LlmUsageLog {
  id       String  @id @default(cuid())
  tenantId String
  userId   String?

  // Request info
  operation  String // "compose", "classify", "summarize", "smart_reply"
  promptId   String? // Reference to PromptTemplate.id
  promptName String? // "email.compose", "router.classify"
  model      String // "mistral-small-latest"

  // Usage metrics
  inputTokens  Int
  outputTokens Int
  totalTokens  Int
  latencyMs    Int // Response time in milliseconds

  // Cost tracking (optional, calculated)
  estimatedCost Float? // In USD or credits

  // Status
  success      Boolean @default(true)
  errorType    String? // "rate_limit", "timeout", "invalid_response"
  errorMessage String?

  // Context
  agentName String? // Which agent made the call
  sessionId String? // ChatSession reference

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, operation])
  @@index([agentName, createdAt])
  @@index([promptName, createdAt])
  @@map("llm_usage_logs")
}

// ============================================
// User Personalization - Semantic Memory
// ============================================

// Stores embeddings of user preferences, facts, and patterns for semantic retrieval
model UserProfileEmbedding {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  // What type of memory this is
  memoryType String @default("PREFERENCE") // PREFERENCE, FACT, PATTERN, INTERACTION, CONTACT_NOTE

  // The content being embedded
  content String // "User prefers morning meetings before 10am"
  vector  Unsupported("vector")? // pgvector embedding

  // Source of this memory
  source     String @default("INFERRED") // EXPLICIT (user said), INFERRED (learned), BEHAVIOR (observed)
  confidence Float  @default(0.5) // 0-1 how confident are we in this memory

  // Metadata
  category  String? // "scheduling", "email", "communication", "contacts"
  expiresAt DateTime? // Some memories should expire

  // Usage tracking
  usageCount Int       @default(0) // How often this memory is used
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation("UserProfileEmbeddingsToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, userId, memoryType])
  @@index([tenantId, userId, category])
  @@index([expiresAt])
  @@map("user_profile_embeddings")
}

// Writing Style Profile - Learned from user's sent emails
model WritingStyleProfile {
  id       String @id @default(cuid())
  tenantId String
  userId   String @unique

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Structure metrics
  avgSentenceLength Float @default(15) // Average words per sentence
  avgParagraphLines Float @default(3) // Average lines per paragraph
  avgWordsPerEmail  Int   @default(100)
  bulletListRate    Float @default(0) // Usage rate of bullet lists (0-1)

  // Vocabulary metrics
  formalityScore  Float @default(0.5) // 0=very casual, 1=very formal
  contractionRate Float @default(0.3) // Rate of contractions used (0-1)
  emojiRate       Float @default(0) // Emoji usage rate (0-1)
  typeTokenRatio  Float @default(0.5) // Vocabulary diversity

  // Punctuation habits
  exclamationRate Float @default(0) // Rate of sentences with !
  questionRate    Float @default(0) // Rate of sentences with ?
  ellipsisRate    Float @default(0) // Usage of ...

  // Greeting/Sign-off patterns (stored as JSON arrays)
  greetingPresent    Boolean  @default(true)
  preferredGreetings String[] @default([])
  signOffPresent     Boolean  @default(true)
  preferredSignOffs  String[] @default([])

  // Tone metrics
  sentimentPolarity Float @default(0) // -1 (negative) to 1 (positive)
  empathyPhraseRate Float @default(0) // Rate of empathy phrases
  hedgeRate         Float @default(0) // Uncertainty markers ("perhaps", "maybe")

  // Learning metadata
  sampleCount         Int      @default(0) // Number of emails analyzed
  lastAnalyzedEmailId String? // Track last processed email
  lastAnalyzed        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId, userId])
  @@map("writing_style_profiles")
}

// ============================================
// VoltAgent Memory System - 2025 Best Practices
// ============================================

// VoltAgent Conversation - Enhanced session management
// Replaces/extends ChatSession with better memory features
model VoltAgentConversation {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  // Conversation metadata
  title        String?
  locale       String   @default("en")
  lastActiveAt DateTime @default(now())
  messageCount Int      @default(0)

  // Memory management
  isSummarized     Boolean @default(false) // Has this conversation been compressed?
  summaryUpToIndex Int? // Messages summarized up to this index

  // Status
  isArchived Boolean @default(false)
  isDeleted  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  messages  VoltAgentMessage[]
  summaries ConversationSummary[]

  @@index([tenantId, userId, lastActiveAt])
  @@index([tenantId, userId, isDeleted])
  @@map("voltagent_conversations")
}

// VoltAgent Message - Individual messages with semantic search support
// Enables hybrid search: vector similarity + recency decay
model VoltAgentMessage {
  id             String @id @default(cuid())
  conversationId String
  tenantId       String
  userId         String

  // Message content
  role    String // "user" | "assistant" | "system"
  content String @db.Text

  // Semantic search support (pgvector)
  vector Unsupported("vector")? // 1024-dim embedding for semantic search

  // Tool execution metadata
  toolCalls   Json? // Array of tool invocations
  toolResults Json? // Array of tool results

  // Ordering and recency
  messageIndex Int // Sequential index within conversation

  // Metadata
  tokenCount Int? // Token count for context management
  metadata   Json?

  createdAt DateTime @default(now())

  // Relations
  conversation VoltAgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, messageIndex])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, createdAt]) // For recency queries
  @@map("voltagent_messages")
}

// Conversation Summary - Memory compression for long conversations
// 2025 Best Practice: Summarize older messages to save context window
model ConversationSummary {
  id             String @id @default(cuid())
  conversationId String
  tenantId       String
  userId         String

  // Summary content
  summary String @db.Text // Compressed summary of messages

  // Semantic search support
  vector Unsupported("vector")? // Embedding for summary retrieval

  // What was summarized
  startMessageIndex   Int // First message in this summary
  endMessageIndex     Int // Last message in this summary
  messageCountCovered Int // Number of messages summarized

  // Key facts extracted (for structured retrieval)
  keyFacts Json? // Array of { fact: string, importance: number }
  topics   String[] @default([]) // Main topics discussed

  // Quality metrics
  summaryTokens Int? // Token count of summary

  createdAt DateTime @default(now())

  // Relations
  conversation VoltAgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([tenantId, userId])
  @@map("conversation_summaries")
}
