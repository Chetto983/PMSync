    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.17",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/he": "^1.2.3",
    "@types/imapflow": "^1.0.189",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^27.0.0",
