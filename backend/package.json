    "async-mutex": "^0.5.0",
    "autumn-js": "^0.1.75",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.5.4",
    "bullmq": "^5.67.3",
    "cheerio": "^1.2.0",
    "chrono-node": "^2.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cloudflare": "^5.2.0",
