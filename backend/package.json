{
  "name": "@mailagent/backend",
  "version": "1.0.0",
  "description": "PMSync Backend API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "cd .. && husky install .husky",
    "prebuild": "prisma generate && rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:prod:win": "set NODE_ENV=production&& node --max-old-space-size=512 dist/main",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:win": "set NODE_OPTIONS=--max-old-space-size=8192 && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "type-check": "tsc --noEmit"
  },
