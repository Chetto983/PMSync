{
  "name": "@pmsync/backend",
  "version": "1.0.0",
  "description": "PMSync Backend API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "cd .. && husky install .husky",
    "prebuild": "prisma generate && rimraf dist .tsbuildinfo",
    "prestart:dev": "rimraf .tsbuildinfo",
    "prestart:debug": "rimraf .tsbuildinfo",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 nest start --watch",
    "start:debug": "cross-env NODE_OPTIONS=--max-old-space-size=8192 nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:prod:win": "set NODE_ENV=production&& node --max-old-space-size=512 dist/main",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:win": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "type-check": "tsc --noEmit",
    "vitest": "vitest run",
    "vitest:watch": "vitest",
    "dep:check": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json src",
    "dep:circular": "madge --circular --extensions ts --ts-config tsconfig.json src",
    "dep:baseline": "depcruise --config .dependency-cruiser.cjs --output-type baseline --output-to .dependency-cruiser-known-violations.json src",
    "openapi:generate": "ts-node scripts/generate-openapi.ts",
    "openapi:lint": "spectral lint ./openapi-spec.json --ruleset .spectral.yaml",
    "contract-test": "jest --testPathPatterns=contract --forceExit"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^3.0.19",
    "@aws-sdk/client-s3": "^3.985.0",
