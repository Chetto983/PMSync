# PMSync Frontend Environment Variables
# Copy this file to .env.local and update values for your environment

# =============================================================================
# API Configuration (REQUIRED)
# =============================================================================

# Backend API origin used by the Next.js proxy routes.
# Browser requests go to same-origin /api/auth/* and /api/v1/*.
# Development: http://localhost:3000
# Production: Your actual backend URL (e.g., https://your-domain.com)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://mail-agent-indol.vercel.app

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
#
# 1. The NEXT_PUBLIC_ prefix is required for client-side access
# 2. After changing .env.local, restart the Next.js dev server
# 3. For production, set this in your deployment environment
#
# Priority order (Next.js):
#   .env.local (highest - local overrides, git ignored)
#   .env.development / .env.production (environment-specific)
#   .env (lowest - shared defaults)

# =============================================================================
# better-auth Configuration (v5.0)
# =============================================================================

# Base URL for better-auth (must match where the frontend is running)
BETTER_AUTH_URL=http://localhost:3001

# Secret key for better-auth session signing (generate a random 32+ char string)
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Database URL for frontend Prisma client (same as backend)
DATABASE_URL=postgresql://user:password@localhost:5432/pmsync

# =============================================================================
# CSRF Protection (SEC-04)
# =============================================================================
# No frontend env vars needed - CSRF token fetched automatically from backend
# Backend must have CSRF_SECRET configured and /api/v1/auth/csrf-token endpoint

# =============================================================================
# SMTP Configuration (for email verification and password reset)
# =============================================================================
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply
SMTP_FROM_DOMAIN=pmsync.local
