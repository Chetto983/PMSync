# PostgreSQL 15 with Citus (horizontal sharding) + pgvector (AI embeddings)
# Using postgres_15 tag to match existing data
FROM citusdata/citus:postgres_15

# Install pgvector from PGDG repository
RUN apt-get update && \
    apt-get install -y --no-install-recommends postgresql-15-pgvector && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
